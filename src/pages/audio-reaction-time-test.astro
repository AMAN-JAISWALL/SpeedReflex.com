---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolHero from '../components/ToolHero.astro';
import ReactionTest from '../components/ReactionTest.astro';
import Section from '../components/Section.astro';
import DataTable from '../components/DataTable.astro';
import Callout from '../components/Callout.astro';
import Faq from '../components/Faq.astro';
import RelatedTools from '../components/RelatedTools.astro';
import { toolById } from '../lib/site';
import { toolCrumbs, toolPage, type FaqItem } from '../lib/schema';
import { ANTICIPATION_MS } from '../lib/reaction';

const tool = toolById('audio');
const title = 'Audio Reaction Time Test — How Fast Do You React to Sound?';
const description =
  'React to a beep instead of a flash. Five attempts give your average, best and consistency — and show how your ears compare with your eyes.';

const faqs: FaqItem[] = [
  {
    q: 'What is a good audio reaction time?',
    a: 'In lab studies, young adults react to a sound in about 160 ms on average — roughly 30 ms faster than to a light. Online, your speaker or headphones add delay, so the fairest benchmark is your own visual result on the same device.',
  },
  {
    q: 'Why is my audio reaction time slower than my visual one?',
    a: 'Usually the equipment. Bluetooth headphones and some speakers delay the sound, and not every browser reports that delay. Try the phone’s own speaker or wired headphones, turn the volume up and test somewhere quiet.',
  },
  {
    q: 'I can’t hear the beep. What should I do?',
    a: 'Check the volume and that the browser tab isn’t muted. On iPhone, switch off silent mode if you still hear nothing. Close other apps that are playing audio, then reload the page and start again.',
  },
  {
    q: 'Does the screen give the beep away?',
    a: 'No. The panel stays dark and the text doesn’t change when the beep plays, so the only signal is the sound itself.',
  },
  {
    q: 'Is this like a sprint start?',
    a: `Very close. Sprinters react to the sound of the gun, and World Athletics treats any reaction under 0.100 s as a false start. This test uses the same rule: presses under ${ANTICIPATION_MS} ms after the beep are counted as guesses.`,
  },
  {
    q: 'Are my results saved?',
    a: 'Yes, in your browser on this device only, separately from your visual reaction test history. Nothing is uploaded, and Clear History wipes it.',
  },
];
---

<BaseLayout title={title} description={description} jsonLd={toolPage(tool, title, description, faqs)}>
  <ToolHero
    crumbs={toolCrumbs(tool)}
    eyebrow="Reflex test · Sound"
    title="Audio Reaction Time Test"
    lede="Wait for the beep, then react as fast as you can. Sound reaches the brain sooner than light, so most people score faster here than on a visual test — take both and find out how big your own difference is."
    features={['Timed from the speaker, not the code', 'No visual cue', 'Ears vs eyes comparison', 'Progress saved on this device', 'No sign-up']}
  >
    <ReactionTest stimulus="audio" />
    <div class="mt-4 max-w-3xl">
      <Callout tone="warning" title="Turn Your Sound On">
        Turn the volume up before you start. On iPhone, switch off silent mode if you can’t hear the beep. Bluetooth headphones add
        their own delay, so the phone speaker or wired headphones give the fairest result.
      </Callout>
    </div>
  </ToolHero>

  <Section id="how-it-works" eyebrow="How it works" title="Five Beeps, One Honest Number">
    <ol class="grid gap-4 md:grid-cols-3">
      {
        [
          { n: '01', t: 'Start', d: 'Tap, click or press Space. The panel turns dark and stays that way — keep your finger ready.' },
          { n: '02', t: 'Listen', d: 'After a random pause of 1.5–4.5 seconds you’ll hear a short beep. Nothing on screen changes, so only your ears can tell you.' },
          { n: '03', t: 'React', d: 'Press the instant you hear it. After five valid attempts you get your average, best, median and consistency.' },
        ].map((s) => (
          <li class="card p-6">
            <span class="font-mono text-xs text-mute">{s.n}</span>
            <h3 class="mt-4 text-heading-md">{s.t}</h3>
            <p class="mt-2 text-sm leading-6 text-body">{s.d}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section
    id="sound-vs-sight"
    eyebrow="Science"
    title="Why You React Faster to Sound Than to Sight"
    intro="Lab studies have found the same gap for more than a century: about 160 ms for a sound against about 190 ms for a light in young adults."
  >
    <div class="grid gap-10 lg:grid-cols-2">
      <div class="prose-sr">
        <p>
          A sound reaches the brain in roughly 8–10 milliseconds. Light has to be converted into nerve signals by the retina and
          processed by the visual system first, which takes about 20–40 ms before the signal even arrives. That head start carries
          through to your finger.
        </p>
        <p>
          It’s one reason sprint starts use a gun: athletes react to the sound, and anything under 0.100 s is ruled a false start
          because nobody can genuinely hear and respond that fast. For the numbers behind all of this, see our guide to <a href="/average-reaction-time/">average reaction time</a>.
        </p>
      </div>
      <div class="grid content-start gap-4 sm:grid-cols-2">
        <div class="card p-6">
          <p class="eyebrow">Sight</p>
          <p class="mt-3 text-heading-lg">≈190 ms</p>
          <p class="mt-2 text-sm leading-6 text-body">Simple reaction to a light, young adults in lab studies.</p>
        </div>
        <div class="card p-6">
          <p class="eyebrow">Sound</p>
          <p class="mt-3 text-heading-lg">≈160 ms</p>
          <p class="mt-2 text-sm leading-6 text-body">Simple reaction to a sound, in the same studies.</p>
        </div>
      </div>
    </div>
  </Section>

  <Section
    id="audio-latency"
    eyebrow="Accuracy"
    title="Speakers and Headphones Add Delay"
    intro="Sound has to travel through your device before you hear it. SpeedReflex starts the clock when the browser says the beep reaches the output — which covers the delays the browser knows about."
  >
    <DataTable
      caption="How audio output affects a measured reaction time"
      head={['How you listen', 'Effect on your result']}
      rows={[
        ['Phone or laptop speaker', 'Best choice — small, known delay'],
        ['Wired headphones', 'Just as good as the speaker'],
        ['Bluetooth headphones or speakers', 'Often over 100 ms of extra delay, not always reported to the browser'],
        ['TV or external speaker via HDMI', 'Can add noticeable delay; avoid for testing'],
      ]}
      note="For a fair sound-vs-sight comparison, take both tests on the same device with the same setup."
    />
  </Section>

  <Section id="compare" eyebrow="Compare" title="Audio, Visual or F1: Which Test?">
    <div class="grid gap-4 md:grid-cols-3">
      <div class="card p-6">
        <p class="eyebrow">Audio test</p>
        <p class="mt-3 text-sm leading-6 text-body">A beep with nothing on screen. Measures how fast you respond to sound — like a sprinter at the gun.</p>
      </div>
      <div class="card p-6">
        <p class="eyebrow">Visual test</p>
        <p class="mt-3 text-sm leading-6 text-body">The panel flashes blue. The classic <a href="/reaction-time-test/" class="font-medium text-link hover:text-link-deep">reaction time test</a>, with your percentile.</p>
      </div>
      <div class="card p-6">
        <p class="eyebrow">F1 start</p>
        <p class="mt-3 text-sm leading-6 text-body">Five red lights, then lights out. The <a href="/f1-reaction-time-test/" class="font-medium text-link hover:text-link-deep">F1 reaction test</a> adds the pressure of not jumping the start.</p>
      </div>
    </div>
  </Section>

  <Faq items={faqs} title="Audio Reaction Test FAQ" />
  <RelatedTools current={tool.id} />
</BaseLayout>
