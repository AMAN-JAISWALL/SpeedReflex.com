---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolHero from '../components/ToolHero.astro';
import Speedometer from '../components/Speedometer.astro';
import Section from '../components/Section.astro';
import StepList from '../components/StepList.astro';
import DataTable from '../components/DataTable.astro';
import Faq from '../components/Faq.astro';
import RelatedTools from '../components/RelatedTools.astro';
import { toolById } from '../lib/site';
import { toolCrumbs, toolPage, type FaqItem } from '../lib/schema';

const tool = toolById('bus');
const title = 'Bus Speed Test — How Fast Is My Bus Going? (GPS)';
const description =
  'Check the live speed of the bus or coach you’re on with a free GPS speedometer. See max and average speed, distance and GPS accuracy — no app needed.';

const faqs: FaqItem[] = [
  {
    q: 'How fast is a bus in speed?',
    a: 'A typical city transit bus cruises between <strong>30 and 50 km/h (20 to 31 mph)</strong> on urban streets, though frequent passenger stops and traffic lights reduce its overall commercial average speed to roughly <strong>12 to 20 km/h (7.5 to 12.5 mph)</strong>. Intercity express coaches and highway tour buses travel much faster, cruising at <strong>90 to 100 km/h (56 to 62 mph)</strong>.',
  },
  {
    q: 'How to find the speed of the bus?',
    a: 'To check your bus\'s speed, open this <strong>Bus Speed Test</strong> on your mobile phone while seated inside the bus. Tap <strong>Start GPS</strong> and hold your device near a window. Because your phone travels with the vehicle, the GPS calculates the bus\'s exact velocity over the road.',
  },
  {
    q: 'What is the normal speed of a bus?',
    a: 'The normal cruising speed for urban buses is 40–50 km/h on open avenues and 20–30 km/h in congested downtown sectors. Long-distance express coaches operate at normal highway speeds of 90–100 km/h (55–62 mph).',
  },
  {
    q: 'What is a bus speed?',
    a: 'In transportation, <strong>bus speed</strong> denotes the travel rate of a passenger road omnibus. In computer hardware engineering, however, "bus speed" refers to the communication bandwidth and clock frequency of an internal computer data bus (such as the Front-Side Bus or memory bus) connecting the CPU to RAM and peripheral components.',
  },
  {
    q: 'What is bus speed in RAM?',
    a: 'In computer architecture, <strong>RAM bus speed</strong> refers to the operational frequency at which the memory bus transfers data between the system memory and the processor, measured in Megahertz (MHz) or Megatransfers per second (MT/s). For instance, standard DDR4 memory operates at bus transfer speeds of 2400 to 3200 MT/s, while newer DDR5 operates at 4800 to 6400+ MT/s. (This is a computer hardware term distinct from vehicular transit speed).',
  },
  {
    q: 'Why do city buses have low average speeds?',
    a: 'City bus average speeds are heavily reduced by passenger "dwell time" (boarding, ticketing, and disembarking at every stop), red traffic lights, and urban gridlock. Consequently, a bus with a top speed of 60 km/h often completes its urban route with an average speed of only 12–16 km/h.',
  },
  {
    q: 'Are long-distance coach buses governed to a maximum speed?',
    a: 'Yes. In the European Union, UK, and many other jurisdictions, commercial passenger buses and coaches over 3.5 tonnes are legally mandated to install electronic engine governors capping maximum road speed to <strong>100 km/h (62 mph)</strong>.',
  },
  {
    q: 'Why does it take a while to get a GPS signal on a bus?',
    a: 'The metal roof and tinted side windows of buses attenuate GNSS satellite signals. Sitting next to a side window or sitting on the upper deck of a double-decker bus provides the clearest line of sight to orbiting satellites.',
  },
  {
    q: 'How accurate is the bus speed reading?',
    a: 'Once your smartphone acquires a satellite lock (accuracy < 15–20 m), the speedometer reading is accurate to within 1–2 km/h. Accuracy briefly drops when passing through underpasses or deep street canyons.',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={toolPage(tool, title, description, faqs)}
>
  <ToolHero
    crumbs={toolCrumbs(tool)}
    eyebrow="GPS speed test"
    title="Bus Speed Test"
    lede="Wondering how fast your bus or coach is really going? Open this page on your phone, press Start and see the live speed from your seat — with GPS accuracy, max speed and distance travelled."
    features={['Works from any seat', 'Shows GPS accuracy', 'Max & moving average', 'Distance travelled', 'No app, no sign-up']}
  >
    <Speedometer preset="bus" />
  </ToolHero>

  <Section id="how-to" eyebrow="How to" title="How to Check Your Bus Speed">
    <StepList
      steps={[
        { title: 'Pick a Window Seat', text: 'Glass lets satellite signals through; the metal roof doesn’t. The upper deck is even better.' },
        { title: 'Press Start', text: 'Allow location access. Nothing leaves your phone — it’s only used to calculate speed.' },
        { title: 'Wait for Blue', text: 'When the signal dot turns blue and accuracy drops below ~20 m, readings are reliable.' },
      ]}
    />
  </Section>

  <Section
    id="bus-speeds"
    eyebrow="Reference"
    title="How Fast Do Buses Usually Go?"
    intro="Buses spend a lot of time at stops and in traffic, so their average speed is much lower than their top speed. Many countries also limit how fast buses and coaches can go."
  >
    <DataTable
      caption="Typical bus and coach speeds"
      head={['Situation', 'Typical speed']}
      rows={[
        ['City bus, average including stops', 'Often 15–25 km/h (9–16 mph)'],
        ['Coach on a motorway, EU & UK', 'Speed limiters cap coaches at 100 km/h (62 mph)'],
        ['Transport vehicles in India', 'Speed governors, commonly set to 80 km/h'],
        ['Coaches in the US', 'Posted limits apply; many fleets set their own caps'],
      ]}
      note="Figures are typical and rules differ by country, operator and road. Speed limits for buses may be lower than for cars."
    />
  </Section>

  <Section id="jumpy-readings" eyebrow="Accuracy" title="Why the Speed Jumps Around on a Bus">
    <div class="grid gap-px overflow-hidden rounded-md border border-hairline bg-hairline sm:grid-cols-2 lg:grid-cols-4">
      {
        [
          { t: 'Metal Roof', d: 'The bus body blocks satellites. Near a window the signal is far steadier.' },
          { t: 'Tall Buildings', d: 'Signals bounce off glass and concrete in city centres, adding noise.' },
          { t: 'Stops and Starts', d: 'Frequent braking is real — your max and moving average smooth it out.' },
          { t: 'Tunnels', d: 'GPS drops out underground. We ignore glitches when the signal returns.' },
        ].map((f) => (
          <div class="bg-surface p-6">
            <h3 class="text-label text-ink">{f.t}</h3>
            <p class="mt-2 text-sm leading-6 text-body">{f.d}</p>
          </div>
        ))
      }
    </div>
    <div class="prose-sr mt-8 max-w-3xl">
      <p>
        Taking the train instead? The <a href="/train-speed-test/">train speed test</a> is tuned for high-speed rail and explains
        why coated train windows block GPS.
      </p>
    </div>
  </Section>

  <Faq items={faqs} title="Bus Speed Test FAQ" />
  <RelatedTools current={tool.id} />
</BaseLayout>
