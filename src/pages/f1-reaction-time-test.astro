---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolHero from '../components/ToolHero.astro';
import F1Start from '../components/F1Start.astro';
import Section from '../components/Section.astro';
import Faq from '../components/Faq.astro';
import RelatedTools from '../components/RelatedTools.astro';
import { toolById } from '../lib/site';
import { toolCrumbs, toolPage, type FaqItem } from '../lib/schema';
import { ANTICIPATION_MS, F1_TIERS } from '../lib/reaction';

const tool = toolById('f1');
const FIA_REGS = 'https://www.fia.com/system/files/documents/fia_2026_f1_regulations_-_section_b_sporting_-_iss_05_-_2026-02-27.pdf';
const F1_STARTS =
  'https://www.formula1.com/en/latest/article/rapid-decisions-driver-skills-and-intricate-procedures-why-race-starts-are.3uziERC5iPE5EYOPRmerXU';
const title = 'F1 Reaction Time Test — Beat the Formula 1 Start Lights';
const description =
  'F1 reaction time test with the real five-light start sequence, random hold and jump-start detection. Get your launch time and your slot on a 20-car grid.';

let lower = 0;
const tierRows = F1_TIERS.map((t) => {
  const range =
    t.max === Infinity ? `${lower.toFixed(3)} s or slower` : lower === 0 ? `Under ${t.max.toFixed(3)} s` : `${lower.toFixed(3)}–${(t.max - 0.001).toFixed(3)} s`;
  lower = t.max;
  return { range, label: t.label, note: t.note };
});

const faqs: FaqItem[] = [
  {
    q: 'How to take an F1 reaction time test?',
    a: `<p>To take an F1 reaction time test on SpeedReflex:</p>
<ol>
  <li><strong>Start the test:</strong> Tap or click the start gantry or press the spacebar to initiate the start sequence.</li>
  <li><strong>Watch the lights:</strong> Five red lights will illuminate one by one at one-second intervals.</li>
  <li><strong>Wait for the random delay:</strong> Once all five lights are on, a random hold between 0.2 and 3.0 seconds occurs before lights out.</li>
  <li><strong>React instantly:</strong> Tap, click, or hit the spacebar the millisecond the lights extinguish.</li>
  <li><strong>Avoid a false start:</strong> Pressing while lights are still red or reacting in under 100 ms counts as a jump start.</li>
</ol>`,
  },
  {
    q: 'How can I check my reaction time in F1?',
    a: 'You can check your F1 reaction time right here on SpeedReflex using your phone, tablet, or PC without downloading an app. The test measures your response time from the exact frame the lights turn off to your input. After five attempts, your average and best times are calculated, and your score is matched against a simulated 20-car Formula 1 starting grid.',
  },
  {
    q: 'How fast is F1 driver reaction time?',
    a: 'Formula 1 drivers average reaction times between <strong>180 and 220 milliseconds (0.18 to 0.22 seconds)</strong> at race starts. Notably, official F1 telemetry measures total launch time — which includes biological reaction time, releasing the hand clutch paddle, and mechanical drivetrain bite.',
  },
  {
    q: 'What is a good F1 reaction time score?',
    a: `<p>Scores on this F1 start simulator can be evaluated against these performance benchmarks:</p>
<ul>
  <li><strong>Under 150 ms:</strong> Elite reflex tier, rivaling professional esports drivers or near-anticipation.</li>
  <li><strong>150–200 ms:</strong> Formula 1 driver pace — competitive with the top tier of motorsport.</li>
  <li><strong>200–250 ms:</strong> Above average — quick reflexes typical of trained club racers and gamers.</li>
  <li><strong>250–350 ms:</strong> Average human reaction range for everyday drivers.</li>
  <li><strong>Over 350 ms:</strong> Slower reaction — on a Grand Prix grid, you would be swamped into Turn 1.</li>
</ul>`,
  },
  {
    q: 'What is the 90% rule in F1?',
    a: 'In Formula 1 strategy and driver coaching, the informal "90% rule" emphasizes that approximately 90% of race start positions and opening-lap overtakes on modern high-downforce circuits are determined by the initial reaction time and acceleration in the first 100 meters before Turn 1. (In official FIA sporting regulations, the sport historically enforced the <strong>107% rule</strong> in qualifying, requiring every car to lap within 107% of the pole position time to be permitted to start).',
  },
  {
    q: 'Is 0.1 reaction time possible?',
    a: 'A 0.100-second (100 ms) reaction time to a visual stimulus is at the physiological limit of the human nervous system. Visual signals take about 20–40 ms just to travel from the retina through the optic nerve to the visual cortex, plus 60–80 ms to process and transmit motor commands down the spinal cord to your finger muscles. Both the FIA and World Athletics classify any response under 100 ms as anticipatory anticipation (a false start or jump start).',
  },
  {
    q: 'Which F1 driver has the quickest reaction time?',
    a: 'Telemetry highlights <strong>Valtteri Bottas</strong>, <strong>Max Verstappen</strong>, <strong>Fernando Alonso</strong>, and <strong>Lewis Hamilton</strong> as having among the quickest launches in modern F1. Bottas notably executed a 0.201-second start at the 2017 Austrian Grand Prix and a borderline 0.04-second anticipatory start in 2020 that cleared FIA transponder sensors without penalty.',
  },
  {
    q: 'What is the fastest human reaction time?',
    a: 'In clinical neuroscience studies, the fastest recorded human reaction times are approximately <strong>120–140 ms for acoustic (sound) stimuli</strong> and <strong>150–180 ms for visual stimuli</strong> under laboratory conditions with zero input latency. Anything consistently below 100 ms represents anticipatory guessing rather than an organic reflex.',
  },
  {
    q: 'Why do F1 lights go out instead of turning green?',
    a: 'Formula 1 starts utilize lights-out rather than green lights because extinguishing a stimulus eliminates color interpretation latency. The random hold time (between 0.2 and 3 seconds) prevents drivers from anticipating the start through rhythm, forcing pure reactive starts.',
  },
  {
    q: 'What counts as a jump start in this test?',
    a: `Pressing while any red lights are still illuminated, or pressing in less than ${ANTICIPATION_MS} ms after lights out. Because human neurophysiology cannot process and react faster than 100 ms, scores below this threshold indicate guessing and are discarded from your verified stats.`,
  },
  {
    q: 'How do F1 drivers train their reaction time?',
    a: 'F1 drivers train with specialized equipment like Batak Pro reaction boards, Blazepod light reaction sensors, trainer-dropped tennis ball catching drills, and advanced driving simulators under elevated heart rates and heavy G-force conditioning.',
  },
  {
    q: 'What is the penalty for a false start in Formula 1?',
    a: 'Under FIA Formula 1 regulations, an illegal start detected by in-track inductive loops and onboard transponders results in a <strong>5-second or 10-second time penalty</strong> added to the driver\'s pit stop, or a drive-through penalty for severe jump starts.',
  },
  {
    q: 'Is the 20-car grid position real?',
    a: 'The grid position is a realistic simulation. After each verified launch, the tool models 19 simulated competitor reaction times centered around a 0.215 s average with normal variance to show where you would slot into the pack before Turn 1.',
  },
  {
    q: 'Are my F1 start times saved?',
    a: 'Yes. Your best reaction time, session average, and recent starts are saved locally in your browser storage. No personal data or scores are ever sent to an external server.',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={toolPage(tool, title, description, faqs)}
>
  <ToolHero
    crumbs={toolCrumbs(tool)}
    eyebrow="Reflex test · Motorsport"
    title="F1 Reaction Time Test"
    lede="Line up on the grid. Five red lights come on one by one, hold for a random moment, then go out — react the instant they do. Get your launch time to the millisecond and see where you’d slot into a 20-car field."
    features={['Authentic five-light sequence', 'Jump-start detection', 'Simulated 20-car grid', 'Optional light beeps', 'Space, click or tap']}
  >
    <F1Start />
  </ToolHero>

  <Section
    id="start-lights"
    eyebrow="The start procedure"
    title="How F1 Start Lights Work"
    intro="At a Formula 1 start, five red light panels above the grid switch on one after another at one-second intervals. Once all five are lit, they hold for a variable, unannounced moment — then go out together. There is no green light: lights out means go."
  >
    <ol class="grid gap-4 md:grid-cols-3">
      {
        [
          { n: '01', t: 'Lights On', d: 'In this simulator the first light comes on shortly after you start, then one more every second until all five are lit.' },
          { n: '02', t: 'The Hold', d: 'All five stay lit for a random 0.2–3 seconds, the same window Formula 1 describes for real starts. You can’t count it — that’s the point.' },
          { n: '03', t: 'Lights Out', d: 'React the instant the gantry goes dark. Your time is measured from the frame the lights disappeared.' },
        ].map((s) => (
          <li class="card p-6">
            <span class="font-mono text-xs text-mute">{s.n}</span>
            <h3 class="mt-4 text-heading-md">{s.t}</h3>
            <p class="mt-2 text-sm leading-6 text-body">{s.d}</p>
          </li>
        ))
      }
    </ol>
    <p class="mt-6 text-xs text-mute">
      Sources: <a href={FIA_REGS} rel="noopener" target="_blank" class="underline underline-offset-2 hover:text-ink">FIA 2026 Formula 1
      Sporting Regulations</a>, Articles B5.7 (start procedure) and B5.11 (false start);
      and <a href={F1_STARTS} rel="noopener" target="_blank" class="underline underline-offset-2 hover:text-ink">Formula1.com on race starts</a>.
    </p>
  </Section>

  <Section
    id="good-f1-reaction-time"
    eyebrow="Benchmarks"
    title="What Is a Good F1 Reaction Time?"
    intro="Formula 1 says its drivers launch about 0.2 seconds after lights out on average — including getting the car moving. On a phone or computer, here’s how your launch compares."
  >
    <div class="max-w-3xl overflow-x-auto rounded-md border border-hairline bg-surface">
      <table class="data-table">
        <caption class="sr-only">F1 start reaction time ratings</caption>
        <thead>
          <tr><th scope="col">Reaction</th><th scope="col">Rating</th><th scope="col" class="max-sm:hidden">What it means</th></tr>
        </thead>
        <tbody>
          {
            tierRows.map((r) => (
              <tr>
                <td class="whitespace-nowrap">{r.range}</td>
                <td>
                  <span class="sm:whitespace-nowrap">{r.label}</span>
                  <span class="mt-1 block text-mute sm:hidden">{r.note}</span>
                </td>
                <td class="max-sm:hidden">{r.note}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <div class="prose-sr mt-8 max-w-3xl">
      <p>
        For comparison, most people average around a quarter of a second on a simple online reaction test. Our guide
        to <a href="/average-reaction-time/">average reaction time</a> shows how that varies with age, device and whether you react
        to a light or a sound.
      </p>
    </div>
  </Section>

  <Section
    id="reaction-time-test-f1"
    eyebrow="Compare"
    title="Reaction Time Test, F1-Style: What’s Different?"
    intro="A classic reaction time test and an F1 start both measure how quickly you respond to what you see — but they test you in different ways."
  >
    <div class="grid gap-4 md:grid-cols-2">
      <div class="card p-6">
        <p class="eyebrow">Classic reaction test</p>
        <ul class="prose-sr mt-4 text-sm leading-6">
          <li>Something <strong>appears</strong> — a panel changes colour.</li>
          <li>No build-up, so there’s little temptation to guess.</li>
          <li>Measures pure visual reaction speed.</li>
        </ul>
        <a href="/reaction-time-test/" class="mt-5 inline-flex text-sm font-medium text-link hover:text-link-deep">Take the reaction time test →</a>
      </div>
      <div class="card p-6">
        <p class="eyebrow">F1 start test</p>
        <ul class="prose-sr mt-4 text-sm leading-6">
          <li>Something <strong>disappears</strong> — the lights go out.</li>
          <li>Five lights build tension; the random hold punishes anticipation.</li>
          <li>Measures reaction speed and self-control together.</li>
        </ul>
      </div>
    </div>
  </Section>

  <Section id="jump-starts" eyebrow="Rules" title="Jump Starts and the Simulated Grid">
    <div class="prose-sr max-w-3xl">
      <p>
        In Formula 1, each car’s transponder shows whether it moved before the lights went out, and the stewards punish a false start
        with a time, drive-through or stop-and-go penalty. Here, pressing while any light is on — or less than {ANTICIPATION_MS} ms
        after lights out, which is faster than a human can genuinely react — counts as a <strong>jump start</strong>. It isn’t saved,
        and you line up again.
      </p>
      <p>
        After every clean start we draw 19 rival reaction times around 0.215 s with a realistic spread and count how many you beat.
        That gives your <strong>grid slot off the line</strong> — P1 means you out-reacted the whole simulated field. It’s a bit of fun
        rather than real driver data, but it shows how a few hundredths of a second reshuffle the order into turn one.
      </p>
    </div>
  </Section>

  <Section id="train" eyebrow="Training" title="Train Your Starts Like a Driver">
    <div class="grid gap-px overflow-hidden rounded-md border border-hairline bg-hairline sm:grid-cols-2 lg:grid-cols-3">
      {
        [
          { t: 'Soft Focus on the Gantry', d: 'Take in all five lights at once rather than fixing on the last one. The change registers sooner.' },
          { t: 'Relaxed, Loaded Finger', d: 'Rest lightly on the key or screen. Tension slows the press; a relaxed hand fires faster.' },
          { t: 'Never Count the Hold', d: 'The hold is random. Counting leads straight to jump starts — wait for the lights, not the clock.' },
          { t: 'Short, Sharp Sessions', d: 'Ten starts, a break, ten more. Your history chart shows whether the trend is heading down.' },
          { t: 'Use a Reaction Light Board', d: 'Drivers train on wall-mounted reaction lights. Any game that makes you hit random targets builds the same skill.' },
          { t: 'Rest and Hydrate', d: 'Fatigue shows up first in reaction time. Your fastest starts come when you’re fresh.' },
        ].map((f) => (
          <div class="bg-surface p-6">
            <h3 class="text-label text-ink">{f.t}</h3>
            <p class="mt-2 text-sm leading-6 text-body">{f.d}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <Faq items={faqs} title="F1 Reaction Test FAQ" />
  <RelatedTools current={tool.id} />
</BaseLayout>
