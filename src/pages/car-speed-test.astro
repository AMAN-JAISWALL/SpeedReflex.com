---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolHero from '../components/ToolHero.astro';
import Speedometer from '../components/Speedometer.astro';
import Section from '../components/Section.astro';
import StepList from '../components/StepList.astro';
import DataTable from '../components/DataTable.astro';
import Callout from '../components/Callout.astro';
import Faq from '../components/Faq.astro';
import RelatedTools from '../components/RelatedTools.astro';
import { toolById } from '../lib/site';
import { toolCrumbs, toolPage, type FaqItem } from '../lib/schema';

const tool = toolById('car');
const title = 'Car Speed Test — Free GPS Speedometer vs Your Dashboard';
const description =
  'A free online GPS car speed test: check your driving speed against the dashboard, set a speed alert and use HUD mode at night — no app needed.';

const r39 = [30, 50, 80, 100, 120].map((v) => [`${v} km/h`, `${v}–${Math.floor(v * 1.1 + 4)} km/h`]);

const faqs: FaqItem[] = [
  {
    q: 'How do I test my car speed?',
    a: `<p>To test your car\'s true speed:</p>
<ol>
  <li>Open this <strong>Car Speed Test</strong> on your smartphone.</li>
  <li>Mount your phone in a secure windshield or dashboard cradle with a clear view of the sky.</li>
  <li>Tap <strong>Start GPS</strong> and grant location permission when prompted.</li>
  <li>Drive at a steady speed. The live gauge and digital readout reflect your ground speed in real time.</li>
</ol>`,
  },
  {
    q: 'How can I check my car\'s speed online?',
    a: 'You can check your car\'s speed online using SpeedReflex directly in your mobile web browser (Chrome, Safari, Edge, Samsung Internet). The tool uses satellite Geolocation to determine ground velocity with 1–2 km/h precision — no app store download, account creation, or OBD-II hardware required.',
  },
  {
    q: 'How to check car speed on mobile?',
    a: 'Open SpeedReflex on your mobile phone, press Start, and keep the browser in the foreground. The page automatically engages the Screen Wake Lock API to prevent your phone screen from dimming or locking while you drive.',
  },
  {
    q: 'How to check if a speedometer is accurate?',
    a: 'To check your speedometer\'s accuracy, cruise at a steady speed (e.g. 100 km/h or 60 mph) on a flat, straight road with a clear sky view and compare your dashboard needle to this GPS speedometer. Under international law (such as UN ECE Regulation 39), car manufacturers calibrate speedometers never to under-read, meaning dashboards usually show 3% to 8% higher than true GPS speed.',
  },
  {
    q: 'How do cars measure speed?',
    a: 'Modern cars measure speed via Wheel Speed Sensors (ABS tone rings) or transmission output shaft speed sensors. The car\'s computer counts wheel rotations per second and multiplies by the presumed rolling radius of the tire. Because tire wear, inflation pressure, and tire models change circumference, dashboard speedometers are prone to mechanical variance.',
  },
  {
    q: 'How to detect vehicle speed?',
    a: `<p>Vehicle speed can be detected through several methods:</p>
<ul>
  <li><strong>Satellite GPS:</strong> Calculates ground speed via Doppler shift frequency changes from GNSS satellites (used by SpeedReflex).</li>
  <li><strong>Vehicle Speed Sensors (VSS):</strong> Measures rotation of transmission gears or wheel hubs.</li>
  <li><strong>Police Radar & Laser (LiDAR):</strong> Radar measures Doppler frequency shift of reflected radio waves; LiDAR emits rapid light pulses to measure distance delta over time.</li>
  <li><strong>Roadside Inductive Loops:</strong> Wire coils embedded in roadway pavement calculate velocity as metal passes between two fixed points.</li>
</ul>`,
  },
  {
    q: 'How to calculate speed of car in km/h?',
    a: `<p>To calculate speed manually from distance and time:</p>
<p><strong>Speed (km/h) = Distance (km) ÷ Time (hours)</strong></p>
<p>If distance is in meters and time is in seconds:</p>
<p><strong>Speed (km/h) = (Meters ÷ Seconds) × 3.6</strong></p>
<p><em>Example:</em> If a vehicle travels 500 meters in 20 seconds, speed = (500 ÷ 20) × 3.6 = 90 km/h (55.9 mph).</p>`,
  },
  {
    q: 'What is a speedometer or odometer?',
    a: 'A <strong>speedometer</strong> measures instantaneous velocity (how fast the vehicle travels at that exact moment in km/h or mph). An <strong>odometer</strong> records cumulative total distance traveled over time (in kilometers or miles). SpeedReflex acts as both: displaying live speed on the gauge and tracking trip distance.',
  },
  {
    q: 'Does tire size or wear affect dashboard speedometer readings?',
    a: 'Yes. As tire tread wears down (or if you fit smaller-diameter wheels), the tire makes more revolutions per kilometer, causing your car\'s dashboard to display a higher speed than you are actually traveling. Conversely, larger aftermarket tires cause your speedometer to read lower than your true road speed.',
  },
  {
    q: 'How accurate is a GPS car speedometer?',
    a: 'Under open sky, GPS speedometers on modern smartphones are accurate to within 1–2 km/h (0.6–1.2 mph). This is because GNSS chipsets calculate speed using satellite radio signal Doppler shifts rather than simple point-to-point displacement. Accuracy reduces in tunnels or deep urban canyons with obstructed line-of-sight.',
  },
  {
    q: 'How does HUD mode work?',
    a: 'HUD (Heads-Up Display) mode inverts and mirrors your speed readout horizontally in high-contrast digits. Place your phone flat against your dashboard beneath the windshield at night, and the reflection on the glass allows you to monitor your speed without taking your eyes off the road.',
  },
  {
    q: 'Is it legal to use a phone GPS speedometer in a car?',
    a: 'Yes, provided your smartphone is mounted securely in a dedicated phone holder or cradle and you do not operate or hold the phone with your hands while driving.',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={toolPage(tool, title, description, faqs)}
>
  <ToolHero
    crumbs={toolCrumbs(tool)}
    eyebrow="GPS speed test"
    title="Car Speed Test"
    lede="This GPS car speed test turns your phone into a live speedometer. Compare your speed with the dashboard, set a speed alert, or flip to HUD mode and read your speed off the windshield at night."
    features={['Live GPS speed', 'HUD windshield mode', 'Speed alert with beep', 'Keeps the screen on', 'GPX trip export', 'Location stays on your device']}
  >
    <Speedometer preset="car" />
    <div class="mt-4 max-w-3xl">
      <Callout tone="warning" title="Set Up Before You Drive">
        Never handle your phone while driving. Mount it, press Start before you pull away, or let a passenger run the speedometer —
        and follow local laws on phone use.
      </Callout>
    </div>
  </ToolHero>

  <Section id="how-to" eyebrow="How to" title="How to Check Your Car’s Speed With Your Phone">
    <StepList
      steps={[
        { title: 'Mount Your Phone', text: 'Use a dashboard or vent mount with a view of the sky through the windshield.' },
        { title: 'Press Start', text: 'Allow location access when asked. Your position is only used on this device.' },
        { title: 'Wait for a Fix', text: 'The dot turns blue once accuracy is good — usually a few seconds outdoors.' },
        { title: 'Drive', text: 'Read live speed, max, moving average, distance and trip time. Export the trip as GPX when you’re done.' },
      ]}
    />
  </Section>

  <Section
    id="gps-vs-dashboard"
    eyebrow="Accuracy"
    title="Why GPS Speed Is Lower Than Your Dashboard"
    intro="Almost every car speedometer reads high on purpose. Under UN ECE Regulation 39, a speedometer must never show less than your true speed, but it may show up to 10% plus 4 km/h more. GPS measures your true speed over the ground, so it usually reads a little lower."
  >
    <DataTable
      caption="Allowed speedometer reading for a given true speed under UN ECE Regulation 39"
      head={['True speed (GPS)', 'Dashboard may legally show']}
      rows={r39}
      note="Worn or non-standard tyres change the gap too: smaller rolling diameter makes the dashboard read higher still."
    />
    <div class="prose-sr mt-8 max-w-3xl">
      <p>
        <strong>For a fair comparison</strong>, let a passenger read the phone while you hold a steady speed on a straight, open road,
        with the signal dot blue. Readings taken while speeding up, braking or under bridges will disagree more.
      </p>
      <p>
        A phone’s GPS is a useful cross-check, not a calibrated instrument: its accuracy depends on the satellite signal at that moment.
        If you need your speedometer checked officially, a garage or testing station uses calibrated equipment.
      </p>
    </div>
  </Section>

  <Section id="hud" eyebrow="Night driving" title="HUD Mode: Your Speed on the Windshield">
    <div class="grid gap-10 lg:grid-cols-2">
      <div class="prose-sr">
        <p>
          A head-up display keeps your eyes on the road. Tap <strong>HUD</strong> and SpeedReflex fills the screen with huge, mirrored digits
          on pure black. Lay the phone flat on the dashboard just below the windshield and the glass reflects your speed the right way
          round.
        </p>
        <ul>
          <li>Works best at night or in low light, with screen brightness turned up.</li>
          <li>The screen stays awake while HUD is open.</li>
          <li>Digits turn red when you pass your speed alert.</li>
          <li>Turn <strong>Mirror</strong> off to read the phone directly, like a big digital speedometer.</li>
        </ul>
      </div>
      <div class="flex items-center justify-center rounded-md border border-hairline bg-black p-10" aria-hidden="true">
        <div class="text-center text-white" style="transform: scaleX(-1)">
          <p class="text-[5rem] font-semibold leading-none tracking-[-0.05em] tabular-nums">88</p>
          <p class="mt-2 font-mono text-sm text-white/60">KM/H</p>
        </div>
      </div>
    </div>
  </Section>

  <Section
    id="speed-limits"
    eyebrow="Reference"
    title="Typical Motorway Speed Limits for Cars"
    intro="Set your speed alert to the limit where you drive. These are typical national maximums for cars on motorways and freeways — posted signs always take priority."
  >
    <DataTable
      caption="Typical motorway speed limits for cars by country"
      head={['Country', 'Typical motorway limit']}
      rows={[
        ['United States', '55–85 mph (set by each state)'],
        ['United Kingdom', '70 mph'],
        ['Germany', '130 km/h advisory; some sections unrestricted'],
        ['France', '130 km/h (110 km/h in rain)'],
        ['India', 'Up to 120 km/h on expressways'],
        ['Australia', '100–110 km/h (up to 130 km/h in parts of the NT)'],
        ['Canada', '100–120 km/h (set by each province)'],
      ]}
      note="Limits change and vary by road, vehicle type and conditions. Always follow posted signs."
    />
    <div class="prose-sr mt-8 max-w-3xl">
      <p>
        Knowing your true speed is half the picture; the other half is how far you need to stop. At 70 mph that’s around 96 metres on
        a dry road — try your own speed and reaction time in the <a href="/stopping-distance-calculator/">stopping distance
        calculator</a>. Not in a car? The general <a href="/speedometer/">online speedometer</a> works for any trip.
      </p>
    </div>
  </Section>

  <Faq items={faqs} title="Car Speed Test FAQ" />
  <RelatedTools current={tool.id} />
</BaseLayout>
