---
import { Timer, Eye, Lock, Smartphone, Bell, ChartLine } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import ToolCard from '../components/ToolCard.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { GUIDES, REFLEX_TOOLS, SITE, SPEED_TOOLS, toolById } from '../lib/site';
import { webPage, type FaqItem } from '../lib/schema';
import { DIST, POPULATION, distX, distributionPaths, percentFasterThan } from '../lib/reaction';
import { GAUGE, arcPath } from '../lib/speed';

const title = 'SpeedReflex — Reaction Time Tests & Online GPS Speedometer';
const { line, area } = distributionPaths();
const demoMs = 212;
const gaugeTrack = arcPath(GAUGE.start, GAUGE.start + GAUGE.sweep);

const features = [
  { icon: Timer, title: 'Frame-Accurate Timing', text: 'Reaction tests start the clock on the frame the signal is painted and read the hardware timestamp of your press.' },
  { icon: Eye, title: 'Colour-Blind-Safe Signal', text: 'A dark-to-blue flash is a big brightness change, so it reads just as clearly with red–green colour blindness.' },
  { icon: Lock, title: 'Private by Design', text: 'No accounts, no tracking. GPS positions and test history never leave your device.' },
  { icon: Smartphone, title: 'HUD & Always-On Screen', text: 'Mirror your speed onto the windshield at night. The screen stays awake while a trip runs.' },
  { icon: Bell, title: 'Speed Alerts', text: 'Set a limit for your car, e-bike or scooter and get a beep and vibration the moment you cross it.' },
  { icon: ChartLine, title: 'Progress & GPX Export', text: 'Track your reaction times over weeks, and export any trip as GPX for Strava, Komoot or Google Earth.' },
];

const stats = [
  { value: `${POPULATION.medianMs} ms`, label: 'Median browser reaction time in our population model' },
  { value: '≈0.2 s', label: 'Start reaction commonly reported for Formula 1 drivers' },
  { value: '25 km/h', label: 'Where EU e-bike pedal assistance cuts out' },
  { value: '900 km/h', label: 'Typical ground speed of a jet at cruise, before wind' },
];

const faqs: FaqItem[] = [
  {
    q: 'Is SpeedReflex free?',
    a: 'Yes. Every reaction test and speed test is free to use, with no account and no limits.',
  },
  {
    q: 'Do I need to install an app?',
    a: 'No. Everything runs in your web browser on phones, tablets and computers. You can add SpeedReflex to your home screen for one-tap access.',
  },
  {
    q: 'Which devices do the speed tests work on?',
    a: 'Any phone or tablet with GPS and a modern browser — Safari, Chrome, Edge, Firefox or Samsung Internet. Most laptops and desktops have no GPS chip, so use your phone for speed tests.',
  },
  {
    q: 'Is my data private?',
    a: 'Yes. Your location is processed only in your browser and is never uploaded. Reaction test history is stored locally on your device and you can clear it at any time.',
  },
  {
    q: 'Which test should I start with?',
    a: 'Try the Reaction Time Test for a clean measure of your reflexes, then the F1 Reaction Time Test to see how you handle a race start. For speed, open the online speedometer or pick the page for how you’re travelling — car, bike, bus, train or plane.',
  },
];
---

<BaseLayout title={title} description={SITE.description} jsonLd={webPage({ href: '/', name: title, description: SITE.description, faq: faqs })}>
  <section class="relative isolate overflow-hidden border-b border-hairline">
    <div class="mesh pointer-events-none absolute left-1/2 top-[-6rem] -z-10 h-[34rem] w-[64rem] -translate-x-1/2 opacity-70 dark:opacity-40" aria-hidden="true"></div>
    <div class="shell pb-20 pt-16 text-center sm:pb-24 sm:pt-28">
      <p class="eyebrow">How fast are you, really?</p>
      <h1 class="mx-auto mt-4 max-w-3xl text-[2.5rem] font-semibold leading-[1.05] tracking-[-0.05em] sm:text-[3.75rem]">
        Test Your Reaction Time. Check Your Real Speed.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-7 text-body">
        Test your reflexes with frame-accurate reaction tests, or turn your phone into a GPS speedometer for the car, bike, train or
        plane. Free, private and instant — no app, no sign-up.
      </p>
      <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/reaction-time-test/" class="btn btn-lg btn-primary">Start Reaction Test</a>
        <a href="/speedometer/" class="btn btn-lg btn-secondary">Open Speedometer</a>
      </div>

      <div class="mx-auto mt-16 grid max-w-5xl gap-4 text-left sm:grid-cols-2 lg:grid-cols-3">
        <a href="/reaction-time-test/" class="group card block p-5 shadow-float transition-[border-color] hover:border-hairline-strong">
          <span class="sr-only">Try the reaction time test</span>
          <div aria-hidden="true">
            <p class="eyebrow">Reaction time</p>
            <p class="mt-3 text-heading-lg tabular-nums">{demoMs} ms</p>
            <p class="mt-1 text-sm text-body">Excellent · faster than {Math.round(percentFasterThan(demoMs))}%</p>
            <svg viewBox={`0 0 ${DIST.width} ${DIST.base + 6}`} class="mt-4 h-auto w-full text-ink">
              <path d={area} fill="currentColor" fill-opacity="0.08" />
              <path d={line} fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round" />
              <line x1={distX(demoMs)} x2={distX(demoMs)} y1={DIST.top} y2={DIST.base} class="stroke-link" stroke-width="4" />
              <circle cx={distX(demoMs)} cy={DIST.base} r="8" class="fill-link stroke-surface" stroke-width="3" />
            </svg>
          </div>
        </a>

        <a href="/f1-reaction-time-test/" class="group card block p-5 shadow-float transition-[border-color] hover:border-hairline-strong">
          <span class="sr-only">Try the F1 reaction time test</span>
          <div aria-hidden="true">
            <p class="eyebrow">F1 start</p>
            <p class="mt-3 text-heading-lg tabular-nums">0.198 s</p>
            <p class="mt-1 text-sm text-body">F1 pace · P2 off the line</p>
            <div class="mt-4 flex justify-between gap-1.5 rounded-sm bg-gantry p-2.5">
              {
                Array.from({ length: 5 }, (_, i) => (
                  <span class="flex flex-1 flex-col items-center gap-1.5 rounded-[4px] bg-gantry-panel py-2">
                    <span class:list={['size-4 rounded-full', i < 4 ? 'bg-lamp-on shadow-lamp' : 'bg-lamp-off']} />
                    <span class:list={['size-4 rounded-full', i < 4 ? 'bg-lamp-on shadow-lamp' : 'bg-lamp-off']} />
                  </span>
                ))
              }
            </div>
          </div>
        </a>

        <a href="/speedometer/" class="group card block p-5 shadow-float transition-[border-color] hover:border-hairline-strong sm:col-span-2 lg:col-span-1">
          <span class="sr-only">Open the GPS speedometer</span>
          <div aria-hidden="true" class="flex items-center gap-4">
            <div class="min-w-0 flex-1">
              <p class="eyebrow">GPS speed</p>
              <p class="mt-3 text-heading-lg tabular-nums">87 km/h</p>
              <p class="mt-1 flex items-center gap-1.5 text-sm text-body">
                <span class="size-2 rounded-full bg-link"></span> GPS ±4 m
              </p>
            </div>
            <svg viewBox="0 0 320 320" class="size-24 shrink-0 text-ink sm:size-28">
              <path d={gaugeTrack} fill="none" stroke-width="18" stroke-linecap="round" class="stroke-hairline" />
              <path d={gaugeTrack} fill="none" stroke-width="18" stroke-linecap="round" pathLength="100" stroke-dasharray="100" stroke-dashoffset="52" class="stroke-ink" />
            </svg>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="border-b border-hairline" aria-label="Highlights">
    <ul class="shell flex flex-wrap justify-center gap-x-10 gap-y-3 py-8 font-mono text-xs uppercase text-mute">
      <li>No sign-up</li>
      <li>No app to install</li>
      <li>Location never leaves your device</li>
      <li>Works on any phone</li>
    </ul>
  </section>

  <Section
    id="reflex-tests"
    eyebrow="Reflex"
    title="Reaction Time Tests"
    intro="Measure how quickly you respond to what you see — from a single flash to a full Formula 1 start sequence."
  >
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {REFLEX_TOOLS.map((t) => <ToolCard tool={t} />)}
      {GUIDES.map((g) => <ToolCard tool={{ ...g, id: 'guide' }} />)}
    </div>
  </Section>

  <Section
    id="speed-tests"
    eyebrow="GPS"
    title="Speed Tests for Every Journey"
    intro="One precise GPS speedometer, tuned for how you travel: the right units, gauge range and features for each."
  >
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {SPEED_TOOLS.map((t) => <ToolCard tool={t} />)}
    </div>
  </Section>

  <Section
    id="speed-and-reflexes"
    eyebrow="Speed × reflexes"
    title="Where Speed Meets Reaction Time"
    intro="On the road, the two numbers SpeedReflex measures multiply. Every tenth of a second you take to react is distance travelled before you even brake."
  >
    <div class="grid items-stretch gap-4 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
      <ToolCard tool={toolById('stopping')} cta="Open Calculator" />
      <div class="card grid content-center gap-4 p-6 sm:grid-cols-3">
        {
          [
            { v: '23 m', l: 'Typical stopping distance at 30 mph' },
            { v: '96 m', l: 'Typical stopping distance at 70 mph' },
            { v: '3.1 m', l: 'Travelled per 0.1 s of reaction at 70 mph' },
          ].map((s) => (
            <div>
              <p class="text-heading-lg tabular-nums">{s.v}</p>
              <p class="mt-1 text-sm leading-6 text-body">{s.l}</p>
            </div>
          ))
        }
      </div>
    </div>
  </Section>

  <Section id="why" eyebrow="Why SpeedReflex" title="Built to Be Accurate, Not Just Fast">
    <div class="grid gap-px overflow-hidden rounded-md border border-hairline bg-hairline sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((f) => (
          <div class="bg-surface p-6 sm:p-8">
            <f.icon size={20} stroke-width={1.75} class="text-ink" />
            <h3 class="mt-4 text-heading-md">{f.title}</h3>
            <p class="mt-2 text-sm leading-6 text-body">{f.text}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <Section id="numbers" eyebrow="Benchmarks" title="Numbers Worth Knowing">
    <dl class="grid gap-px overflow-hidden rounded-md border border-hairline bg-hairline sm:grid-cols-2 lg:grid-cols-4">
      {
        stats.map((s) => (
          <div class="flex flex-col-reverse gap-2 bg-surface p-6">
            <dt class="text-sm leading-6 text-body">{s.label}</dt>
            <dd class="text-heading-lg">{s.value}</dd>
          </div>
        ))
      }
    </dl>
  </Section>

  <Faq items={faqs} />

  <CtaBand
    title="Ready When You Are."
    text="Five attempts, about thirty seconds. See where your reflexes really stand."
    primary={{ href: '/reaction-time-test/', label: 'Start Reaction Test' }}
    secondary={{ href: '/f1-reaction-time-test/', label: 'Try the F1 Start' }}
  />
</BaseLayout>
