---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE } from '../lib/site';
import { webPage, type Crumb } from '../lib/schema';
import { ANTICIPATION_MS, ATTEMPTS_PER_SESSION, POPULATION } from '../lib/reaction';

const title = 'About SpeedReflex — How Our Tests Work';
const description =
  'Who makes SpeedReflex and how its reaction time tests and GPS speedometers measure you: frame-synced timing, GPS filtering, sources and privacy.';
const crumbs: Crumb[] = [
  { name: 'Home', href: '/' },
  { name: 'About', href: '/about/' },
];

const principles = [
  { t: 'Accuracy First', d: 'Timing starts on the painted frame, inputs use hardware timestamps, and GPS glitches are filtered rather than shown as record speeds.' },
  { t: 'Private by Default', d: 'No accounts and no tracking. Location is processed on your device and history stays in your browser.' },
  { t: 'Honest Numbers', d: 'When a figure is modelled — like our reaction-time percentiles — we say so, rather than inventing a leaderboard.' },
  { t: 'Fast Everywhere', d: 'Small pages, no heavy frameworks, and tools that work on a cheap phone on a train as well as a gaming PC.' },
];
---

<BaseLayout title={title} description={description} jsonLd={webPage({ href: '/about/', name: title, description, crumbs, type: 'AboutPage' })}>
  <section class="border-b border-hairline">
    <div class="shell max-w-3xl pb-16 pt-6 sm:pb-24 sm:pt-8">
      <Breadcrumbs crumbs={crumbs} />
      <p class="eyebrow mt-10">About</p>
      <h1 class="mt-3 text-display-sm sm:text-display">Measure Speed. Honestly.</h1>
      <div class="prose-sr mt-8 text-lg leading-8">
        <p>
          SpeedReflex is a small collection of tools for one question: how fast? How fast your hands react to a signal, how fast you launch
          when the lights go out, and how fast you’re really moving in a car, on a bike, on a train or in a plane.
        </p>
        <p>
          Plenty of sites answer those questions. We wanted tools that are more careful about the measurement, kinder to your privacy,
          and pleasant to use — so we built them. This page explains exactly how they work, so you can judge the numbers for yourself.
        </p>
      </div>
    </div>
  </section>

  <section class="border-b border-hairline" aria-labelledby="principles-title">
    <div class="shell py-16 sm:py-24">
      <h2 id="principles-title" class="text-heading-lg">What We Care About</h2>
      <div class="mt-10 grid gap-px overflow-hidden rounded-md border border-hairline bg-hairline sm:grid-cols-2">
        {
          principles.map((p) => (
            <div class="bg-surface p-6 sm:p-8">
              <h3 class="text-heading-md">{p.t}</h3>
              <p class="mt-2 text-sm leading-6 text-body">{p.d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-b border-hairline" aria-labelledby="method-title">
    <div class="shell grid gap-12 py-16 sm:py-24 lg:grid-cols-2">
      <div>
        <p class="eyebrow">Methodology</p>
        <h2 id="method-title" class="mt-3 text-heading-lg">How We Time Your Reactions</h2>
        <ul class="prose-sr mt-6">
          <li>
            <strong>Frame-synced start.</strong> The clock starts when the signal is actually presented on screen, not when the code asks
            for it — removing up to a full frame of error.
          </li>
          <li><strong>Press, not release.</strong> We react to pointer-down and key-down and use the event’s own timestamp.</li>
          <li>
            <strong>No guessing.</strong> Presses before the signal, or under {ANTICIPATION_MS} ms after it, don’t count — the same line
            World Athletics uses for false starts.
          </li>
          <li><strong>Random waits.</strong> The delay before each signal changes every attempt, so you can’t settle into a rhythm.</li>
          <li>
            <strong>Honest percentiles.</strong> A session is {ATTEMPTS_PER_SESSION} attempts. Percentiles come from a log-normal model of
            online reaction times with a median of {POPULATION.medianMs} ms — clearly labelled as a model.
          </li>
        </ul>
        <p class="mt-6 text-sm text-body">
          Background and sources: <a href="/average-reaction-time/" class="font-medium text-link hover:text-link-deep">Average reaction
          time guide</a>.
        </p>
      </div>
      <div>
        <p class="eyebrow">Methodology</p>
        <h2 class="mt-3 text-heading-lg">How We Measure Your Speed</h2>
        <ul class="prose-sr mt-6">
          <li>
            <strong>Receiver speed first.</strong> We use the speed your phone’s satellite receiver reports, which is based on the Doppler
            shift of the signals, and only fall back to position changes when it isn’t available.
          </li>
          <li>
            <strong>Accuracy gate.</strong> Position fixes with poor accuracy don’t count towards distance or top speed.
          </li>
          <li>
            <strong>Glitch filter.</strong> Impossible jumps — typical when the signal returns after a tunnel — are ignored, with a
            plausibility limit tuned for each vehicle.
          </li>
          <li><strong>Standing still means zero.</strong> Below about 2 km/h, GPS wobble is shown as 0 rather than fake movement.</li>
          <li><strong>On-device only.</strong> Your location is processed in the browser and never sent anywhere.</li>
        </ul>
        <p class="mt-6 text-sm text-body">
          Details and troubleshooting: <a href="/speedometer/" class="font-medium text-link hover:text-link-deep">Online speedometer</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="border-b border-hairline" aria-labelledby="contact-title">
    <div class="shell max-w-3xl py-16 sm:py-24">
      <h2 id="contact-title" class="text-heading-lg">Contact and Corrections</h2>
      <div class="prose-sr mt-6">
        <p>
          Spotted a figure that looks wrong, or a tool that misbehaves on your device?
          Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a> and we’ll look into it. How we handle data is set out in
          the <a href="/privacy/">privacy policy</a>.
        </p>
      </div>
    </div>
  </section>

  <CtaBand
    title="Try a Test."
    text="It takes less than a minute."
    primary={{ href: '/reaction-time-test/', label: 'Start Reaction Test' }}
    secondary={{ href: '/speedometer/', label: 'Open Speedometer' }}
  />
</BaseLayout>
