---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Callout from '../components/Callout.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE } from '../lib/site';
import { webPage, type Crumb } from '../lib/schema';

const title = 'Terms & Conditions — SpeedReflex';
const description =
  'Terms of service and acceptable use for SpeedReflex: recreational reflex testing, GPS speedometer usage guidelines, driving safety disclaimers, and limitation of liability.';
const updated = 'October 4, 2026';

const crumbs: Crumb[] = [
  { name: 'Home', href: '/' },
  { name: 'Terms & Conditions', href: '/terms/' },
];
---

<BaseLayout title={title} description={description} jsonLd={webPage({ href: '/terms/', name: title, description, crumbs })}>
  <article class="shell max-w-3xl py-16 sm:py-24">
    <Breadcrumbs crumbs={crumbs} />
    <p class="eyebrow mt-10">Legal</p>
    <h1 class="mt-3 text-display-sm sm:text-display">Terms & Conditions</h1>
    <p class="mt-4 text-sm text-mute">Last updated {updated}</p>

    <div class="prose-sr mt-10">
      <p>
        Welcome to <span translate="no">{SITE.domain}</span> (“SpeedReflex”, “we”, “our”, or “us”). By accessing, browsing,
        or using our website and browser-based applications, you acknowledge that you have read, understood, and agreed to be
        bound by these Terms and Conditions (“Terms”). If you do not agree to these Terms, please do not use SpeedReflex.
      </p>

      <div class="my-8">
        <Callout tone="warning" title="Important Road Safety & Driving Notice">
          SpeedReflex GPS speedometers and stopping calculators are designed for recreational and informational passenger use only.
          <strong>Never interact with, hold, or view your phone or device while driving or riding.</strong> Always obey posted speed
          limits, observe traffic regulations, and rely on your vehicle’s factory-installed, certified speedometer.
        </Callout>
      </div>

      <h2 class="mt-10! text-heading-md text-ink">1. Nature and Purpose of the Service</h2>
      <p>
        SpeedReflex provides free, web-based utilities including reaction time tests (visual stimulus, Formula 1 starting sequence,
        and audio beep), GPS-based speedometers tailored for various modes of travel (car, bicycle, bus, train, flight), and a
        braking and stopping distance calculator.
      </p>
      <p>
        All services are provided strictly for <strong>entertainment, casual benchmarking, educational, and personal informational purposes</strong>.
        SpeedReflex does not provide certified measurement tools or legal verification instruments.
      </p>

      <h2 class="mt-10! text-heading-md text-ink">2. Driving and Traffic Safety Disclaimer</h2>
      <p>
        Your safety and the safety of others on the road is paramount. By using SpeedReflex, you expressly agree:
      </p>
      <ul>
        <li>
          <strong>No distracted driving:</strong> You will not interact with, tap, configure, or read SpeedReflex while actively operating a motor
          vehicle, motorcycle, bicycle, electric scooter, or any other moving conveyance.
        </li>
        <li>
          <strong>Hands-free / passenger operation:</strong> In-vehicle use must be conducted solely by a passenger or configured in a secure,
          hands-free mount prior to departure (including setting Heads-Up Display / HUD mode before driving).
        </li>
        <li>
          <strong>Vehicle speedometer primacy:</strong> Vehicle dashboards are subject to strict regulatory calibration standards (such as UN ECE
          Regulation 39). Satellite GPS signals can be affected by atmospheric delay, satellite geometry, and multipath interference. Your vehicle’s
          dashboard speedometer and local road signage always take absolute legal precedence.
        </li>
        <li>
          <strong>Zero liability for violations:</strong> SpeedReflex accepts no responsibility or liability for traffic infractions, speeding
          fines, license penalties, motor vehicle accidents, personal injuries, or property damage arising out of your operation of any vehicle or
          reliance on GPS readings.
        </li>
      </ul>

      <h2 class="mt-10! text-heading-md text-ink">3. Health and Medical Disclaimer</h2>
      <p>
        Reaction time tests on SpeedReflex measure hand-eye coordination and auditory response within the constraints of web browsers and consumer
        hardware.
      </p>
      <p>
        These tests are <strong>not medical tests, neurological diagnostics, or clinical cognitive assessments</strong>. They must not be used to
        diagnose concussions, assess neurological impairment, determine physical fatigue levels, or certify readiness or medical fitness to drive,
        fly, or operate industrial machinery. If you have medical concerns regarding your reflexes or neurological function, consult a licensed
        medical professional.
      </p>

      <h2 class="mt-10! text-heading-md text-ink">4. Measurement Accuracy and Technical Constraints</h2>
      <p>
        While SpeedReflex implements frame-accurate timing synchronization (via <code>requestAnimationFrame</code>) and Doppler satellite speed
        filtering, measurements are inherently influenced by variables beyond our control:
      </p>
      <ul>
        <li><strong>Display latency:</strong> Screen refresh rates (60 Hz, 120 Hz, 240 Hz), display panel response times, and browser compositing pipelines introduce hardware-specific variations.</li>
        <li><strong>Input latency:</strong> Operating system polling rates, Bluetooth wireless input lag, touch digitization delay, and keyboard debounce filters vary significantly across devices.</li>
        <li><strong>GPS signal accuracy:</strong> Urban canyons (tall buildings), tunnels, dense tree cover, cloud cover, and device antenna hardware affect satellite receiver accuracy and fix update frequency.</li>
      </ul>

      <h2 class="mt-10! text-heading-md text-ink">5. Acceptable Use and Restrictions</h2>
      <p>
        You are granted a personal, non-exclusive, non-transferable, revocable license to access and use SpeedReflex for its intended personal and
        non-commercial purposes. You agree not to:
      </p>
      <ul>
        <li>Use automated scripts, bots, spiders, or scrapers to extract data, benchmark suites, or content from the site.</li>
        <li>Interfere with, disrupt, or place an unreasonable load on our website infrastructure or hosting networks.</li>
        <li>Attempt to reverse engineer, decompile, or disassemble any part of the site’s client code or proprietary algorithms.</li>
        <li>Circumvent or manipulate test parameters, false-start thresholds, or timing mechanisms to falsify benchmark rankings or records.</li>
        <li>Use the site for any unlawful, hazardous, or reckless purpose.</li>
      </ul>

      <h2 class="mt-10! text-heading-md text-ink">6. Intellectual Property Rights</h2>
      <p>
        All content, source code, visual interfaces, graphics, icons, typography, designs, algorithms, and documentation on SpeedReflex are the
        intellectual property of SpeedReflex and its creators, protected by international copyright, trademark, and other proprietary laws.
      </p>
      <p>
        You may share individual test results, challenge URLs, and locally exported GPX tracks with others for personal, non-commercial purposes.
        Reproduction, redistribution, or mirroring of whole or substantial portions of the website without prior written authorization is prohibited.
      </p>

      <h2 class="mt-10! text-heading-md text-ink">7. Disclaimer of Warranties</h2>
      <p>
        SpeedReflex is provided on an <strong>“AS IS”</strong> and <strong>“AS AVAILABLE”</strong> basis, without warranties of any kind, either express
        or implied, including but not limited to warranties of merchantability, fitness for a particular purpose, non-infringement, or accuracy of data.
        We do not warrant that the website will be uninterrupted, error-free, completely accurate, or free from viruses or harmful components.
      </p>

      <h2 class="mt-10! text-heading-md text-ink">8. Limitation of Liability</h2>
      <p>
        To the maximum extent permitted by applicable law, in no event shall SpeedReflex, its authors, affiliates, or contributors be liable for any
        direct, indirect, incidental, special, consequential, or punitive damages, including but not limited to loss of data, loss of profits,
        speeding fines or penalties, vehicle collisions, personal injury, or device malfunction, arising out of or related to your use of or inability
        to use the site.
      </p>

      <h2 class="mt-10! text-heading-md text-ink">9. External Links and Third-Party Resources</h2>
      <p>
        SpeedReflex may reference academic research papers, regulatory standards (such as UN ECE 39), or external tools for informational context.
        We have no control over the content, privacy practices, or availability of third-party websites and assume no responsibility for them.
      </p>

      <h2 class="mt-10! text-heading-md text-ink">10. Modifications to Terms</h2>
      <p>
        We reserve the right to revise or replace these Terms at any time. When changes occur, the “Last updated” date at the top of this document will
        be updated. Your continued use of the website following any revisions constitutes your acceptance of the new Terms.
      </p>

      <h2 class="mt-10! text-heading-md text-ink">11. Contact Information</h2>
      <p>
        If you have questions, feedback, or legal inquiries concerning these Terms & Conditions, please contact us:
      </p>
      <ul>
        <li>Email: <a href={`mailto:${SITE.email}`}>{SITE.email}</a> or <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a></li>
        <li>Online Contact Page: <a href="/contact/">SpeedReflex Contact Page</a></li>
        <li>Privacy inquiries: See our <a href="/privacy/">Privacy Policy</a></li>
      </ul>
    </div>
  </article>

  <CtaBand
    title="Ready to Test Your Reflexes?"
    text="Instant, private, and frame-accurate timing in your browser."
    primary={{ href: '/reaction-time-test/', label: 'Start Reaction Test' }}
    secondary={{ href: '/speedometer/', label: 'Open Speedometer' }}
  />
</BaseLayout>
