---
import TermsView from '../../views/TermsView.astro';
import { NON_DEFAULT_LOCALES, type Locale } from '../../lib/i18n';

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: Locale };
---

<TermsView locale={locale} />
