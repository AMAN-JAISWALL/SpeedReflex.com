---
import { NON_DEFAULT_LOCALES, type Locale } from '../../lib/i18n';
import HomeView from '../../views/HomeView.astro';

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
---

<HomeView locale={locale} />
