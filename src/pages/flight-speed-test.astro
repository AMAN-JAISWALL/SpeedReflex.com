---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolHero from '../components/ToolHero.astro';
import Speedometer from '../components/Speedometer.astro';
import Section from '../components/Section.astro';
import StepList from '../components/StepList.astro';
import DataTable from '../components/DataTable.astro';
import Callout from '../components/Callout.astro';
import Faq from '../components/Faq.astro';
import RelatedTools from '../components/RelatedTools.astro';
import { toolById } from '../lib/site';
import { toolCrumbs, toolPage, type FaqItem } from '../lib/schema';

const tool = toolById('flight');
const title = 'Flight Speed Test — How Fast Is My Plane Going? (GPS)';
const description =
  'Measure your plane’s ground speed, altitude and heading with your phone’s GPS, in km/h, mph or knots. Works in airplane mode once the page is loaded.';

const faqs: FaqItem[] = [
  {
    q: 'How fast is a plane in km/h?',
    a: 'A standard commercial passenger airliner (such as a Boeing 737, 777, 787 or Airbus A320, A350) cruises at approximately <strong>850 to 930 km/h (530 to 580 mph or 460 to 500 knots)</strong> at cruising altitude (32,000–39,000 feet). Smaller regional turboprop airliners cruise around 500 to 650 km/h.',
  },
  {
    q: 'How many kilometers is a 1 hour flight?',
    a: 'In a 1-hour scheduled flight, a commercial aircraft typically covers roughly <strong>500 to 700 kilometers (310 to 435 miles)</strong>. While cruising speed is near 900 km/h, the overall journey average is lower due to initial takeoff climb, descent patterns, and air traffic approach vectors.',
  },
  {
    q: 'Can a plane fly 1000 mph?',
    a: 'Military supersonic aircraft (like the F-15, F-22, or MiG-31) easily exceed 1,000 mph (1,609 km/h, roughly Mach 1.3), and the historic commercial airliner Concorde cruised at 1,350 mph (Mach 2.04). Standard modern passenger jets are aerodynamically limited to subsonic speeds (~Mach 0.85 or ~575 mph airspeed), though with powerful jet-stream tailwinds, their ground speed over the Earth can occasionally exceed 800 mph (1,280+ km/h).',
  },
  {
    q: 'Can a plane fly for 23 hours?',
    a: 'Currently, no scheduled commercial passenger airliner operates a 23-hour nonstop route. The world\'s longest scheduled flight is Singapore Airlines SQ23 (Singapore to New York JFK), flying approximately 18.5 to 19 hours nonstop (15,349 km). Qantas\'s upcoming "Project Sunrise" flights (Sydney to London/New York) will reach 21 to 22 hours. However, military aircraft (via mid-air refueling) and experimental solar-electric drones (like the Airbus Zephyr) can remain airborne for weeks without landing.',
  },
  {
    q: 'Does GPS work in airplane mode?',
    a: 'Yes, on virtually all modern smartphones. Airplane mode turns off transmission radios (cellular, Wi-Fi, Bluetooth), whereas GPS is a passive satellite radio receiver that transmits nothing. If location turns off automatically when enabling airplane mode, simply toggle Location Services back on.',
  },
  {
    q: 'Why is my ground speed faster than the plane’s top speed?',
    a: 'GPS measures ground speed — your velocity over the Earth’s surface. When flying eastbound in high-altitude jet streams, tailwinds exceeding 150–250 km/h add directly to the aircraft\'s airspeed, pushing ground speed past 1,050–1,150 km/h.',
  },
  {
    q: 'Why does the GPS altitude differ from the in-flight map?',
    a: 'Aircraft flight instruments measure pressure altitude calibrated against standard barometric pressure (1013.25 hPa), whereas smartphone GPS measures geometric height above the WGS84 earth ellipsoid. A variance of 200–800 feet between the two is normal.',
  },
  {
    q: 'What is a knot?',
    a: 'A knot is one nautical mile per hour (exactly 1.852 km/h or ~1.151 mph). International aviation and maritime navigation universally use knots for airspeed and wind calculations.',
  },
  {
    q: 'Can I save my flight path?',
    a: 'Yes. Tap <strong>Export GPX</strong> upon landing to download your three-dimensional flight track, which you can open in Google Earth, Strava, or GPS visualizer tools.',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={toolPage(tool, title, description, faqs)}
>
  <ToolHero
    crumbs={toolCrumbs(tool)}
    eyebrow="GPS speed test"
    title="Flight Speed Test"
    lede="How fast is your plane flying right now? With a window seat and your phone’s GPS you can see ground speed, altitude and heading at cruise — no Wi-Fi or data needed once this page is loaded."
    features={['Ground speed in km/h, mph or knots', 'Altitude in feet or metres', 'Compass heading', 'Works in airplane mode', 'GPX flight-track export']}
  >
    <Speedometer preset="flight" />
    <div class="mt-4 max-w-3xl">
      <Callout title="Load Before You Board">
        Open this page while you still have a connection, then switch on airplane mode. It keeps working offline — just don’t reload it
        in the air.
      </Callout>
    </div>
  </ToolHero>

  <Section id="how-to" eyebrow="How to" title="How to Measure Your Flight Speed">
    <StepList
      steps={[
        { title: 'Open Before Boarding', text: 'Load this page on the ground. Once loaded it runs without Wi-Fi or data.' },
        { title: 'Airplane Mode On', text: 'Keep Location Services on — GPS only receives, it never transmits.' },
        { title: 'Get Close to the Window', text: 'The fuselage blocks satellites. A window seat and a few minutes’ patience give the first fix.' },
        { title: 'Press Start', text: 'Choose knots, km/h or mph. Altitude, heading and distance flown update as you go.' },
      ]}
    />
  </Section>

  <Section
    id="ground-speed-vs-airspeed"
    eyebrow="Explained"
    title="Ground Speed vs Airspeed"
    intro="Your phone measures ground speed — how fast you cross the map. Pilots fly by airspeed — how fast the aircraft moves through the air. Wind is the difference."
  >
    <div class="grid gap-4 md:grid-cols-2">
      <div class="card p-6">
        <p class="eyebrow">What GPS shows</p>
        <h3 class="mt-3 text-heading-md">Ground Speed</h3>
        <p class="mt-2 text-sm leading-6 text-body">
          Speed over the Earth’s surface. It decides when you land. A tailwind raises it; a headwind lowers it.
        </p>
      </div>
      <div class="card p-6">
        <p class="eyebrow">What pilots fly</p>
        <h3 class="mt-3 text-heading-md">Airspeed</h3>
        <p class="mt-2 text-sm leading-6 text-body">
          Speed relative to the surrounding air, which is what keeps the wings flying. It’s shown in the cockpit, not on your phone.
        </p>
      </div>
    </div>
  </Section>

  <Section
    id="typical-speeds"
    eyebrow="Reference"
    title="How Fast Do Planes Fly? Typical Speeds and Altitudes"
    intro="Numbers vary by aircraft, weight and weather, but here’s what you can expect to see on a typical jet airliner."
  >
    <DataTable
      caption="Typical speeds and altitudes by phase of flight for commercial jets"
      head={['Phase', 'Typical ground speed', 'Typical altitude']}
      rows={[
        ['Take-off (wheels leave the runway)', '240–290 km/h (130–160 kn)', 'Ground level'],
        ['Climb, below 10,000 ft', 'Up to about 460 km/h (250 kn) plus wind', '0–10,000 ft'],
        ['Cruise', '800–950 km/h (430–510 kn) plus wind', '31,000–41,000 ft'],
        ['Approach & landing', '240–300 km/h (130–160 kn)', 'Descending to ground'],
      ]}
      note="Ground speed at cruise can be much higher with a tailwind or lower with a headwind."
    />
    <div class="prose-sr mt-8 max-w-3xl">
      <p>
        On the ground, the fastest high-speed trains run at 300–350 km/h — faster than a jet at take-off. Check yours with
        the <a href="/train-speed-test/">train speed test</a>.
      </p>
    </div>
  </Section>

  <Faq items={faqs} title="Flight Speed Test FAQ" />
  <RelatedTools current={tool.id} />
</BaseLayout>
