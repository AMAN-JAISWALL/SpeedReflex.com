---
import { ArrowRight } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Section from '../../components/Section.astro';
import ToolCard from '../../components/ToolCard.astro';
import { BLOG_HREF, toolById } from '../../lib/site';
import { blogIndexPage, type Crumb } from '../../lib/schema';
import { blogHref, postsByDate, type BlogTopic } from '../../lib/blog';

const title = 'SpeedReflex Blog — Speedometers, Stopping Distance & Reaction Time';
const description =
  'Practical guides on speedometers, stopping distance and reaction time: why speedometers fail or read wrong, how far vehicles need to stop, and what it means.';
const crumbs: Crumb[] = [
  { name: 'Home', href: '/' },
  { name: 'Blog', href: BLOG_HREF },
];

const posts = postsByDate();
const topics: { topic: BlogTopic; intro: string }[] = [
  { topic: 'Speedometers', intro: 'How speedometers work, why they read wrong or stop working, and how to check and fix them.' },
  { topic: 'Stopping distance', intro: 'How far cars, motorcycles and trucks need to stop — and what that means when they can’t.' },
];
const grouped = topics.map((g) => ({ ...g, posts: posts.filter((p) => p.topic === g.topic) })).filter((g) => g.posts.length);

const tools = (['stopping', 'speedoCalc', 'reaction'] as const).map((id) => {
  const t = toolById(id);
  return { id: t.id, href: t.href, name: t.name, summary: t.summary };
});
---

<BaseLayout
  title={title}
  description={description}
  locale="en"
  localized={false}
  jsonLd={blogIndexPage({
    href: BLOG_HREF,
    name: 'SpeedReflex Blog',
    description,
    crumbs,
    posts: posts.map((p) => ({ href: blogHref(p.slug), title: p.h1, published: p.published })),
  })}
>
  <header class="relative isolate overflow-hidden border-b border-hairline">
    <div class="mesh pointer-events-none absolute -top-48 left-1/2 -z-10 h-[30rem] w-[56rem] -translate-x-1/2 opacity-40 dark:opacity-25" aria-hidden="true"></div>
    <div class="shell pb-12 pt-6 sm:pb-16 sm:pt-8">
      <Breadcrumbs crumbs={crumbs} />
      <div class="mt-6 max-w-3xl">
        <p class="eyebrow">Guides & explainers</p>
        <h1 class="mt-3 text-display-sm sm:text-display">The SpeedReflex Blog</h1>
        <p class="mt-4 text-lg leading-7 text-body">
          Clear, sourced answers about speed and reaction time: how speedometers work and fail, how far vehicles need to stop, and how to
          read the numbers our tools give you.
        </p>
      </div>
    </div>
  </header>

  {
    grouped.map((g) => (
      <Section id={g.topic.toLowerCase().replace(/\s+/g, '-')} eyebrow={g.topic} title={g.topic === 'Speedometers' ? 'Speedometer Guides' : 'Stopping Distance Guides'} intro={g.intro}>
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {g.posts.map((p) => (
            <li>
              <a href={blogHref(p.slug)} class="group card flex h-full flex-col p-6 transition-[border-color,box-shadow] duration-200 hover:border-hairline-strong hover:shadow-float">
                <span class="eyebrow">{p.readMinutes} min read</span>
                <h2 class="mt-3 text-heading-md">{p.h1}</h2>
                <p class="mt-2 flex-1 text-sm leading-6 text-body">{p.excerpt}</p>
                <span class="mt-6 inline-flex items-center gap-1 text-sm font-medium text-ink">
                  Read article <ArrowRight size={14} class="transition-transform duration-200 group-hover:translate-x-0.5 motion-reduce:transition-none" />
                </span>
              </a>
            </li>
          ))}
        </ul>
      </Section>
    ))
  }

  <Section id="reaction-time-guides" eyebrow="Reaction time" title="Reaction Time Guides" intro="Benchmarks and background for the reflex tests.">
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <li>
        <ToolCard tool={{ id: 'guide', href: '/average-reaction-time/', name: 'Average Reaction Time', summary: 'What’s normal, good and fast — by age, stimulus and device, with sources.' }} />
      </li>
      <li>
        <ToolCard tool={{ id: 'ruler', href: '/ruler-drop-test/', name: 'Ruler Drop Test', summary: 'How to test reaction time with a ruler, with the formula, a conversion chart and norms.' }} cta="Open Calculator" />
      </li>
      <li>
        <ToolCard tool={{ id: 'f1', href: '/f1-reaction-time-test/#average-f1-reaction-time', name: 'Average F1 Reaction Time', summary: 'How fast Formula 1 drivers react at the start — and how you compare.' }} cta="See Benchmarks" />
      </li>
    </ul>
  </Section>

  <Section id="tools" eyebrow="Tools" title="Put the Numbers to Work">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {tools.map((t) => <ToolCard tool={t} />)}
    </div>
  </Section>
</BaseLayout>
