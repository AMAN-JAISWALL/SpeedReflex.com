---
import { Mail, Bug, HelpCircle, ShieldCheck, Clock, Send, CheckCircle2, Copy } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE } from '../lib/site';
import { webPage, type Crumb, type FaqItem } from '../lib/schema';

const title = 'Contact Us — SpeedReflex';
const description =
  'Contact the SpeedReflex team. Send questions, bug reports, timing calibration inquiries, feature requests, or privacy questions.';
const crumbs: Crumb[] = [
  { name: 'Home', href: '/' },
  { name: 'Contact', href: '/contact/' },
];

const contactChannels = [
  {
    icon: Mail,
    title: 'General Support & Feedback',
    email: SITE.contactEmail,
    desc: 'General inquiries, feedback on your user experience, or partnership requests.',
    actionLabel: 'Email Support',
  },
  {
    icon: Bug,
    title: 'Bug Reports & Device Issues',
    email: SITE.contactEmail,
    desc: 'Report unusual GPS latency, audio delay, or rendering anomalies on specific hardware.',
    actionLabel: 'Report an Issue',
  },
  {
    icon: HelpCircle,
    title: 'Methodology & Research',
    email: SITE.contactEmail,
    desc: 'Questions about our frame-synced clock, Doppler satellite equations, or statistical distribution model.',
    actionLabel: 'Ask Methodology',
  },
  {
    icon: ShieldCheck,
    title: 'Privacy & Data Protection',
    email: SITE.email,
    desc: 'Inquiries regarding local storage, GDPR, or zero-tracking verification.',
    actionLabel: 'Contact Privacy',
  },
];

const faqs: FaqItem[] = [
  {
    q: 'Why does my car speedometer show a higher speed than SpeedReflex GPS?',
    a: 'Vehicle dashboards are legally mandated (under UN ECE Regulation 39 and US DOT rules) to never under-report vehicle speed and typically display 3% to 8% higher than your true velocity. SpeedReflex measures your actual physical ground speed via direct satellite Doppler shift calculation.',
  },
  {
    q: 'Why was my reaction attempt flagged as an anticipation or false start?',
    a: 'Human nerve impulses take at least 100 ms to travel from retina or ear to the motor cortex and hands. World Athletics uses this exact 100 ms limit to disqualify false starts in sprint events. Any input under 100 ms after the stimulus cannot be a genuine reaction to the signal and is marked as anticipation.',
  },
  {
    q: 'Does SpeedReflex work offline?',
    a: 'Yes! Once loaded in your browser or added to your device home screen, all reaction time tests and GPS speedometer tracking algorithms run locally using client-side JavaScript. Satellite GPS receivers do not require an active internet connection to calculate velocity.',
  },
  {
    q: 'How can I clear my saved test history and settings?',
    a: 'Your scores, theme preference, and vehicle presets are stored exclusively in your browser’s localStorage. You can clear them anytime using the "Clear History" button on test pages, or by clearing SpeedReflex site data in your browser settings.',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={webPage({ href: '/contact/', name: title, description, crumbs, faq: faqs, type: 'ContactPage' })}
>
  <section class="border-b border-hairline">
    <div class="shell max-w-3xl pb-16 pt-6 sm:pb-24 sm:pt-8">
      <Breadcrumbs crumbs={crumbs} />
      <p class="eyebrow mt-10">Get in touch</p>
      <h1 class="mt-3 text-display-sm sm:text-display">Contact Us</h1>
      <p class="mt-6 text-lg leading-8 text-body">
        Have a question about our reaction tests, found a glitch on your phone’s GPS, or want to discuss timing accuracy?
        We’d love to hear from you. Everything on SpeedReflex is built with transparency and precision in mind.
      </p>
    </div>
  </section>

  <!-- Channels Grid -->
  <section class="border-b border-hairline" aria-labelledby="channels-heading">
    <div class="shell py-16 sm:py-24">
      <h2 id="channels-heading" class="text-heading-lg">Inquiry Channels</h2>
      <p class="mt-2 text-sm text-body">Choose the most appropriate topic so we can handle your request swiftly.</p>

      <div class="mt-10 grid gap-px overflow-hidden rounded-md border border-hairline bg-hairline sm:grid-cols-2 lg:grid-cols-4">
        {
          contactChannels.map((c) => (
            <div class="flex flex-col justify-between bg-surface p-6">
              <div>
                <span class="flex size-10 items-center justify-center rounded-sm border border-hairline bg-canvas">
                  <c.icon size={20} class="text-ink" />
                </span>
                <h3 class="mt-4 text-heading-md">{c.title}</h3>
                <p class="mt-2 text-sm leading-6 text-body">{c.desc}</p>
              </div>
              <div class="mt-6 pt-4 border-t border-hairline">
                <a
                  href={`mailto:${c.email}?subject=${encodeURIComponent(c.title)}`}
                  class="text-sm font-medium text-link transition-colors hover:text-link-deep"
                >
                  {c.email} &rarr;
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Contact Form & Troubleshooting Guidance -->
  <section class="border-b border-hairline" aria-labelledby="form-heading">
    <div class="shell grid gap-12 py-16 sm:py-24 lg:grid-cols-12">
      <!-- Form Column -->
      <div class="lg:col-span-7">
        <h2 id="form-heading" class="text-heading-lg">Send a Message</h2>
        <p class="mt-2 text-sm text-body">
          Fill out the form below to generate a pre-addressed message or email us directly at{' '}
          <a href={`mailto:${SITE.contactEmail}`} class="text-link hover:underline">{SITE.contactEmail}</a>.
        </p>

        <form id="contact-form" class="mt-8 grid gap-5">
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="contact-name" class="block text-sm font-medium text-ink">
                Your Name <span class="text-mute">(optional)</span>
              </label>
              <input
                type="text"
                id="contact-name"
                name="name"
                autocomplete="name"
                placeholder="Jane Doe"
                class="mt-1.5 w-full rounded-sm border border-hairline bg-surface px-3 py-2 text-sm text-ink placeholder:text-mute focus:border-link focus:outline-none"
              />
            </div>
            <div>
              <label for="contact-email" class="block text-sm font-medium text-ink">
                Your Email <span class="text-error">*</span>
              </label>
              <input
                type="email"
                id="contact-email"
                name="email"
                required
                autocomplete="email"
                placeholder="you@example.com"
                class="mt-1.5 w-full rounded-sm border border-hairline bg-surface px-3 py-2 text-sm text-ink placeholder:text-mute focus:border-link focus:outline-none"
              />
            </div>
          </div>

          <div>
            <label for="contact-topic" class="block text-sm font-medium text-ink">
              Topic <span class="text-error">*</span>
            </label>
            <select
              id="contact-topic"
              name="topic"
              required
              class="mt-1.5 w-full rounded-sm border border-hairline bg-surface px-3 py-2 text-sm text-ink focus:border-link focus:outline-none"
            >
              <option value="General Feedback">General Feedback & Suggestions</option>
              <option value="Bug Report">Bug Report / Device Incompatibility</option>
              <option value="GPS Speedometer">GPS Speedometer & Accuracy</option>
              <option value="Reaction Time Tests">Reaction Time & Timing Calibration</option>
              <option value="Privacy and Data">Privacy & Data Inquiry</option>
              <option value="Other">Other Inquiry</option>
            </select>
          </div>

          <div>
            <label for="contact-subject" class="block text-sm font-medium text-ink">
              Subject <span class="text-error">*</span>
            </label>
            <input
              type="text"
              id="contact-subject"
              name="subject"
              required
              placeholder="Brief summary of your inquiry"
              class="mt-1.5 w-full rounded-sm border border-hairline bg-surface px-3 py-2 text-sm text-ink placeholder:text-mute focus:border-link focus:outline-none"
            />
          </div>

          <div>
            <label for="contact-message" class="block text-sm font-medium text-ink">
              Message <span class="text-error">*</span>
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows={5}
              required
              placeholder="Describe your question, issue, or feedback in detail..."
              class="mt-1.5 w-full rounded-sm border border-hairline bg-surface px-3 py-2 text-sm text-ink placeholder:text-mute focus:border-link focus:outline-none"
            ></textarea>
          </div>

          <div class="flex flex-wrap items-center gap-3 pt-2">
            <button type="submit" class="btn btn-md btn-primary">
              <Send size={16} /> Send via Email
            </button>
            <button type="button" id="copy-btn" class="btn btn-md btn-secondary">
              <Copy size={16} /> Copy Message
            </button>
          </div>

          <div id="form-feedback" class="hidden rounded-sm border border-hairline p-4 text-sm" role="status"></div>
        </form>
      </div>

      <!-- Guidelines Column -->
      <div class="lg:col-span-5 lg:pl-6">
        <div class="rounded-md border border-hairline bg-surface p-6 sm:p-8">
          <div class="flex items-center gap-2 text-label text-ink">
            <Clock size={16} class="text-mute" />
            <span>Response Time & Details</span>
          </div>
          <p class="mt-3 text-sm leading-6 text-body">
            We aim to review and reply to all technical inquiries and feedback within <strong>24–48 business hours</strong>.
          </p>

          <h3 class="mt-6 text-heading-md">Tips for Reporting Hardware Glitches</h3>
          <p class="mt-2 text-sm leading-6 text-body">
            If you are reporting a timing glitch or inaccurate GPS reading, sharing these details helps us reproduce it immediately:
          </p>
          <ul class="prose-sr mt-4 space-y-2 text-sm">
            <li><strong>Device model:</strong> e.g., iPhone 15 Pro, Samsung Galaxy S24, MacBook Pro M3.</li>
            <li><strong>Browser & Version:</strong> e.g., Safari 18, Chrome 130, Firefox 131.</li>
            <li><strong>Display Refresh Rate:</strong> e.g., 60 Hz, 120 Hz ProMotion, 144 Hz gaming monitor.</li>
            <li><strong>Environment:</strong> e.g., Open motorway, passenger seat on train, urban street.</li>
          </ul>

          <div class="mt-8 border-t border-hairline pt-6">
            <p class="text-xs uppercase tracking-wider text-mute">Quick Legal & About Links</p>
            <div class="mt-3 flex flex-wrap gap-x-4 gap-y-2 text-sm">
              <a href="/about/" class="text-link hover:underline">About SpeedReflex</a>
              <a href="/privacy/" class="text-link hover:underline">Privacy Policy</a>
              <a href="/terms/" class="text-link hover:underline">Terms & Conditions</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pre-Contact FAQ -->
  <Faq items={faqs} />

  <CtaBand
    title="Try a Reaction Test"
    text="Test your real reflexes with frame-accurate timing in your browser."
    primary={{ href: '/reaction-time-test/', label: 'Start Reaction Test' }}
    secondary={{ href: '/speedometer/', label: 'Open Speedometer' }}
  />
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const copyBtn = document.getElementById('copy-btn') as HTMLButtonElement | null;
  const feedback = document.getElementById('form-feedback') as HTMLDivElement | null;

  function getFormData() {
    if (!form) return null;
    const nameInput = form.querySelector<HTMLInputElement>('#contact-name');
    const emailInput = form.querySelector<HTMLInputElement>('#contact-email');
    const topicSelect = form.querySelector<HTMLSelectElement>('#contact-topic');
    const subjectInput = form.querySelector<HTMLInputElement>('#contact-subject');
    const messageInput = form.querySelector<HTMLTextAreaElement>('#contact-message');

    const name = nameInput?.value.trim() || 'Anonymous';
    const email = emailInput?.value.trim() || '';
    const topic = topicSelect?.value || 'General Feedback';
    const subject = subjectInput?.value.trim() || 'SpeedReflex Inquiry';
    const message = messageInput?.value.trim() || '';

    return { name, email, topic, subject, message };
  }

  if (form && feedback) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = getFormData();
      if (!data || !data.email || !data.message) {
        feedback.className = 'mt-4 rounded-sm border border-error/40 bg-error-soft p-4 text-sm text-error-deep';
        feedback.textContent = 'Please provide a valid email and message before sending.';
        feedback.classList.remove('hidden');
        return;
      }

      const emailTo = data.topic === 'Privacy and Data' ? 'privacy@speedreflex.com' : 'contact@speedreflex.com';
      const fullSubject = `[SpeedReflex - ${data.topic}] ${data.subject}`;
      const body = `Name: ${data.name}\nEmail: ${data.email}\nTopic: ${data.topic}\n\nMessage:\n${data.message}\n\n---\nSent via SpeedReflex Contact Form`;

      const mailtoUrl = `mailto:${emailTo}?subject=${encodeURIComponent(fullSubject)}&body=${encodeURIComponent(body)}`;
      window.location.href = mailtoUrl;

      feedback.className = 'mt-4 rounded-sm border border-hairline bg-surface p-4 text-sm text-body';
      feedback.innerHTML = `<strong>Opening your email client...</strong> If your email app does not open automatically, please send your email directly to <a href="mailto:${emailTo}" class="text-link underline">${emailTo}</a> with your message.`;
      feedback.classList.remove('hidden');
    });
  }

  if (copyBtn && feedback) {
    copyBtn.addEventListener('click', async () => {
      const data = getFormData();
      if (!data || !data.message) {
        feedback.className = 'mt-4 rounded-sm border border-warning/40 bg-warning-soft p-4 text-sm text-warning-deep';
        feedback.textContent = 'Please enter a message first before copying.';
        feedback.classList.remove('hidden');
        return;
      }

      const body = `Topic: ${data.topic}\nSubject: ${data.subject}\nFrom: ${data.name} (${data.email || 'No email provided'})\n\n${data.message}`;

      try {
        await navigator.clipboard.writeText(body);
        feedback.className = 'mt-4 rounded-sm border border-hairline bg-surface p-4 text-sm text-body';
        feedback.innerHTML = `<strong>Copied to clipboard!</strong> You can now paste this directly into your email client and send it to <a href="mailto:contact@speedreflex.com" class="text-link underline">contact@speedreflex.com</a>.`;
        feedback.classList.remove('hidden');
      } catch (err) {
        feedback.className = 'mt-4 rounded-sm border border-hairline bg-surface p-4 text-sm text-body';
        feedback.textContent = 'Unable to copy to clipboard automatically. Please select and copy your text manually.';
        feedback.classList.remove('hidden');
      }
    });
  }
</script>
