---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolHero from '../components/ToolHero.astro';
import StoppingCalculator from '../components/StoppingCalculator.astro';
import Section from '../components/Section.astro';
import Callout from '../components/Callout.astro';
import Faq from '../components/Faq.astro';
import RelatedTools from '../components/RelatedTools.astro';
import { toolById } from '../lib/site';
import { toolCrumbs, toolPage, type FaqItem } from '../lib/schema';
import { HIGHWAY_CODE } from '../lib/stopping';

const tool = toolById('stopping');
const title = 'Stopping Distance Calculator — Thinking + Braking Distance';
const description =
  'Calculate stopping distance at any speed from your reaction time and the road surface: thinking distance, braking distance and the total, in metres and feet.';

const faqs: FaqItem[] = [
  {
    q: 'What is the formula for calculating stopping distance?',
    a: `<p>Stopping distance is the sum of thinking distance and braking distance:</p>
<p><strong>Total Stopping Distance = Thinking Distance + Braking Distance</strong></p>
<ul>
  <li><strong>Thinking Distance ($d_t$):</strong> $d_t = v \\times t_r$ (where $v$ is velocity in m/s and $t_r$ is reaction time in seconds).</li>
  <li><strong>Braking Distance ($d_b$):</strong> $d_b = \\frac{v^2}{2a}$ (where $v$ is velocity in m/s and $a$ is vehicle deceleration rate, typically ~6.5 m/s² on dry asphalt).</li>
</ul>`,
  },
  {
    q: 'What is the stopping distance at 30 mph?',
    a: 'According to the UK Highway Code (Rule 126), the typical stopping distance at 30 mph on dry asphalt is <strong>23 meters (75 feet)</strong>, consisting of 9 meters (30 ft) thinking distance and 14 meters (45 ft) braking distance — roughly 6 car lengths.',
  },
  {
    q: 'What is the stopping distance at 70 mph?',
    a: 'At 70 mph on a dry road, total stopping distance is <strong>96 meters (315 feet or ~24 car lengths)</strong>: 21 meters thinking distance and 75 meters braking distance. In wet weather, this extends to at least 171 meters (560 feet).',
  },
  {
    q: 'What is the difference between thinking distance and braking distance?',
    a: '<strong>Thinking distance</strong> is the ground covered while your brain registers a hazard and your foot moves to the brake pedal. <strong>Braking distance</strong> is the physical distance the car travels under deceleration until coming to a complete stop.',
  },
  {
    q: 'Why does braking distance increase quadratically with speed?',
    a: 'Braking distance is proportional to the square of velocity ($v^2$) because braking must dissipate kinetic energy ($E_k = \\frac{1}{2}mv^2$). Doubling your speed quadruples the kinetic energy the brakes must convert into heat, multiplying braking distance by four.',
  },
  {
    q: 'How do wet or icy roads affect stopping distance?',
    a: 'Wet road surfaces reduce tire friction by at least 50%, doubling braking distance ($2\\times$). Packed snow and black ice can multiply braking distance by up to <strong>10 times ($10\\times$)</strong>, requiring over 700 meters to stop from highway speeds.',
  },
  {
    q: 'What reaction time does the Highway Code assume?',
    a: 'The UK Highway Code assumes a perception-reaction time of roughly <strong>0.67 seconds</strong>. In real-world driving conditions, driver studies (Green, 2000) show that common unexpected events (like brake lights ahead) trigger an average 1.25-second reaction time, while sudden surprises take 1.5 seconds or more.',
  },
  {
    q: 'What is the 2-second rule for following distance?',
    a: 'The 2-second rule is a safety benchmark for dry roads: select a stationary marker (like a signpost or bridge). When the vehicle ahead passes it, count "one thousand and one, one thousand and two." If you reach the marker before finishing, you are tailgating too closely. In wet weather, double this to 4 seconds; on icy roads, leave up to 10–20 seconds of gap.',
  },
];
---

<BaseLayout title={title} description={description} jsonLd={toolPage(tool, title, description, faqs)}>
  <ToolHero
    crumbs={toolCrumbs(tool)}
    eyebrow="Driving · Speed & reaction time"
    title="Stopping Distance Calculator"
    lede="How far does a car travel before it stops? Enter your speed, how quickly you react and the road conditions to see your thinking distance, braking distance and total stopping distance — in metres, feet and car lengths."
    features={['Any speed in mph or km/h', 'Your own reaction time', 'Dry, wet and icy roads', 'Matches Highway Code figures']}
  >
    <StoppingCalculator />
  </ToolHero>

  <Section
    id="formula"
    eyebrow="How it works"
    title="How Stopping Distance Is Calculated"
    intro="Stopping distance has two parts, and they grow in very different ways as you go faster."
  >
    <div class="grid gap-4 md:grid-cols-3">
      <div class="card p-6">
        <p class="eyebrow">Part 1</p>
        <h3 class="mt-3 text-heading-md">Thinking Distance</h3>
        <p class="mt-2 font-mono text-sm text-ink">speed × reaction time</p>
        <p class="mt-3 text-sm leading-6 text-body">
          The distance covered before your foot reaches the brake. It grows in step with speed — twice as fast, twice as far.
        </p>
      </div>
      <div class="card p-6">
        <p class="eyebrow">Part 2</p>
        <h3 class="mt-3 text-heading-md">Braking Distance</h3>
        <p class="mt-2 font-mono text-sm text-ink">speed² ÷ (2 × deceleration)</p>
        <p class="mt-3 text-sm leading-6 text-body">
          The distance the car needs to stop once braking. It grows with the square of speed — twice as fast, four times as far.
        </p>
      </div>
      <div class="card p-6">
        <p class="eyebrow">Total</p>
        <h3 class="mt-3 text-heading-md">Stopping Distance</h3>
        <p class="mt-2 font-mono text-sm text-ink">thinking + braking</p>
        <p class="mt-3 text-sm leading-6 text-body">
          The calculator brakes at about 0.66 g on a dry road — the rate the Highway Code’s figures imply — then doubles braking
          distance for wet roads and multiplies it by ten for ice. The Highway Code is more cautious in the wet: allow at least
          double the whole stopping distance.
        </p>
      </div>
    </div>
  </Section>

  <Section
    id="highway-code"
    eyebrow="Reference"
    title="Typical Stopping Distances (Highway Code)"
    intro="These are the figures learner drivers memorise for the UK theory test, from Rule 126 of the Highway Code. They assume an alert driver, a car in good condition and a dry road."
  >
    <div class="max-w-3xl">
      <div class="overflow-x-auto rounded-md border border-hairline bg-surface">
        <table class="data-table">
          <caption class="sr-only">Typical stopping distances by speed from the UK Highway Code</caption>
          <thead>
            <tr><th scope="col">Speed</th><th scope="col">Thinking</th><th scope="col">Braking</th><th scope="col">Total</th></tr>
          </thead>
          <tbody>
            {
              HIGHWAY_CODE.map((r) => (
                <tr>
                  <td>{r.mph} mph</td>
                  <td>{r.thinking} m</td>
                  <td>{r.braking} m</td>
                  <td>
                    <strong class="font-medium text-ink">{r.total} m</strong> <span class="text-mute">({r.feet} ft)</span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs text-mute">Source: The Highway Code, Rule 126 (GOV.UK). In the wet, allow at least double; on ice, up to ten times.</p>
    </div>
  </Section>

  <Section
    id="reaction-time"
    eyebrow="Reaction time"
    title="Your Reaction Time Behind the Wheel"
    intro="Reaction time is the part of stopping distance you control. At 70 mph a car covers more than 3 metres every tenth of a second."
  >
    <div class="grid gap-10 lg:grid-cols-2">
      <div class="prose-sr">
        <p>
          A <a href="/reaction-time-test/">reaction time test</a> measures a simple reaction: you know exactly what’s coming and you
          only have to press. Most people average around a quarter of a second. Braking takes longer because you first have to
          notice the hazard, decide to stop and move your foot from the accelerator to the brake.
        </p>
        <p>
          In a review of driver braking studies, Marc Green found that drivers who expect to brake respond in
          about <strong>0.7–0.75 seconds</strong>, that unexpected but common signals like brake lights take
          about <strong>1.25 seconds</strong>, and that true surprises take around <strong>1.5 seconds</strong>. Expectation roughly
          doubles or halves your time — more than age or reflexes do.
        </p>
        <p>
          That’s why following distance matters: you can’t react to the car in front any faster than you can see it braking. See
          how the numbers compare in our guide to <a href="/average-reaction-time/">average reaction time</a>.
        </p>
      </div>
      <div class="grid content-start gap-px overflow-hidden rounded-md border border-hairline bg-hairline sm:grid-cols-2">
        {
          [
            { t: 'Tiredness', d: 'After 17–19 hours awake, some test scores matched a 0.05% blood-alcohol level (Williamson & Feyer, 2000).' },
            { t: 'Phones', d: 'Reading or typing takes your eyes off the road, so the hazard isn’t even seen until you look up.' },
            { t: 'Alcohol and Drugs', d: 'Slower reactions and poorer judgement together — and both are illegal to drive with above set limits.' },
            { t: 'Surprise', d: 'The same driver brakes about twice as fast for an expected event as for a surprise.' },
          ].map((f) => (
            <div class="bg-surface p-6">
              <h3 class="text-label text-ink">{f.t}</h3>
              <p class="mt-2 text-sm leading-6 text-body">{f.d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </Section>

  <Section id="conditions" eyebrow="Conditions" title="Wet, Icy and Downhill Roads">
    <div class="grid gap-4 md:grid-cols-2">
      <Callout tone="warning" title="Wet Roads: At Least Double">
        Tyres grip less on wet roads, so the Highway Code says stopping distances will be at least double those on dry roads (Rule
        227). Leave at least a four-second gap to the vehicle in front.
      </Callout>
      <Callout tone="warning" title="Ice and Snow: Up to Ten Times">
        On icy or snowy roads stopping distances can be ten times greater than on dry roads (Rule 230). Drive slowly and brake
        gently well in advance.
      </Callout>
    </div>
    <div class="prose-sr mt-8 max-w-3xl">
      <p>
        Worn tyres, a heavy load and a downhill slope all add braking distance too. Anti-lock brakes (ABS) help you keep steering
        while braking hard, but they don’t make up for too little distance. Checking how fast you’re really going helps:
        a <a href="/car-speed-test/">GPS car speed test</a> shows your true speed, which is usually a little below what the dashboard
        says.
      </p>
    </div>
  </Section>

  <Faq items={faqs} title="Stopping Distance FAQ" />
  <RelatedTools current={tool.id} />
</BaseLayout>
