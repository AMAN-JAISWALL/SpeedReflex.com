---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolHero from '../components/ToolHero.astro';
import Speedometer from '../components/Speedometer.astro';
import Section from '../components/Section.astro';
import StepList from '../components/StepList.astro';
import DataTable from '../components/DataTable.astro';
import Faq from '../components/Faq.astro';
import RelatedTools from '../components/RelatedTools.astro';
import { toolById } from '../lib/site';
import { toolCrumbs, toolPage, type FaqItem } from '../lib/schema';

const tool = toolById('bike');
const title = 'Bike Speed Test — Free GPS Cycling Speedometer';
const description =
  'Measure your bike speed with just your phone: live GPS speed, moving average, distance and moving time for bikes and e-bikes, plus GPX export for Strava.';

const faqs: FaqItem[] = [
  {
    q: 'How to test bike speed?',
    a: `<p>To test your bicycle speed with SpeedReflex:</p>
<ol>
  <li>Open this <strong>Bike Speed Test</strong> on your mobile browser.</li>
  <li>Secure your phone in a handlebar phone mount.</li>
  <li>Press <strong>Start GPS</strong> and approve location access.</li>
  <li>Ride under open sky. Your live speed, moving average, trip distance, and elevation updates continuously.</li>
</ol>`,
  },
  {
    q: 'Is 20 km/h fast on a bike?',
    a: '20 km/h (12.4 mph) is a respectable, steady cruising speed for daily commuters, utility cyclists, and casual fitness riders on flat pavement. It requires approximately 75–100 watts of effort on a standard hybrid or road bicycle.',
  },
  {
    q: 'Is 40 km/h on a bike fast?',
    a: 'Yes, 40 km/h (24.8 mph) is very fast on a bicycle. Sustaining 40 km/h on flat ground requires upwards of 350 to 400 watts of power output — a sustained threshold typically reached only by trained road racers, competitive time-trialists, or during paceline drafting and steep descents. It matches the average flat-stage speed of the professional Tour de France peloton.',
  },
  {
    q: 'How do I calculate my bike speed?',
    a: `<p>To calculate cycling speed manually:</p>
<p><strong>Speed (km/h) = Distance (km) ÷ Time (hours)</strong></p>
<p>You can also calculate theoretical speed based on gear ratio and pedaling cadence:</p>
<p><strong>Speed (km/h) = Cadence (RPM) × (Front Chainring ÷ Rear Cog) × Wheel Circumference (m) × 0.06</strong></p>
<p>SpeedReflex computes this in real time using satellite ground tracking without needing wheel magnets or cadence sensors.</p>`,
  },
  {
    q: 'What speed bike is best?',
    a: `<p>The best number of speeds (gears) depends on where and how you ride:</p>
<ul>
  <li><strong>Single-Speed / 1-Speed:</strong> Best for flat cities and short commutes; simplest mechanics and lowest maintenance.</li>
  <li><strong>7 or 8-Speed:</strong> Ideal for budget commuters and recreational city riders tackling moderate grades.</li>
  <li><strong>11 or 12-Speed (1x or 2x):</strong> The modern standard for road, gravel, and mountain bikes; offers close gear steps for consistent cadence on varied gradients.</li>
  <li><strong>21 to 27-Speed (3x front):</strong> Traditional touring setups offering very low climbing ratios, though with overlapping gear choices.</li>
</ul>`,
  },
  {
    q: 'What is the average cycling speed for different riders?',
    a: 'Beginner commuters average roughly 14–19 km/h (9–12 mph). Regular road cycling enthusiasts average 24–30 km/h (15–19 mph). Semi-pro and elite riders average 34–42+ km/h (21–26+ mph) on training rides and competitive road races.',
  },
  {
    q: 'How fast do street-legal e-bikes go?',
    a: 'Under EU, UK, and Australian regulations (EN 15194), e-bike motor assistance must legally cut out at <strong>25 km/h (15.5 mph)</strong>. In the US, Class 1 and Class 2 e-bikes assist up to <strong>20 mph (32 km/h)</strong>, while Class 3 speed pedelecs assist up to <strong>28 mph (45 km/h)</strong>.',
  },
  {
    q: 'Is a phone as accurate as a bike computer?',
    a: 'Under open sky, smartphone GPS speed corresponds to dedicated GPS bike computers (Garmin, Wahoo) within 1 km/h. Traditional magnet wheel sensors measure tire revolutions; GPS measures actual ground displacement. GPS is remarkably accurate except under dense tree canopies or inside tunnels.',
  },
  {
    q: 'How do I upload my ride to Strava or Komoot?',
    a: 'Tap <strong>Export GPX</strong> at the end of your trip to download your standard GPS track file. You can immediately upload this file to Strava (via web upload), Komoot, or Garmin Connect with full elevation and route data.',
  },
  {
    q: 'What is moving average speed?',
    a: 'Moving average only counts time when your bicycle is in motion (faster than ~3 km/h). Stopping at traffic lights, pedestrian crossings, or coffee breaks is excluded from the average calculation, mirroring how Garmin and Wahoo cyclocomputers operate.',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={toolPage(tool, title, description, faqs)}
>
  <ToolHero
    crumbs={toolCrumbs(tool)}
    eyebrow="GPS speed test"
    title="Bike Speed Test"
    lede="Measure your cycling speed with just your phone — no sensor, no app. Live speed, moving average, distance and moving time for bicycles, e-bikes and motorbikes, with an optional speed alert."
    features={['No sensor or app needed', 'Moving average & moving time', 'Auto-ranging gauge', 'Speed alert', 'Altitude & heading', 'GPX export for Strava']}
  >
    <Speedometer preset="bike" />
  </ToolHero>

  <Section id="how-to" eyebrow="How to" title="How to Measure Your Bike Speed">
    <StepList
      steps={[
        { title: 'Mount Your Phone', text: 'A handlebar or stem mount keeps the screen visible and the GPS antenna facing the sky.' },
        { title: 'Start Before You Roll', text: 'Press Start and allow location. Wait until the dot turns blue for an accurate first reading.' },
        { title: 'Ride', text: 'Speed updates every second. Stops don’t count against your moving average.' },
        { title: 'Save Your Ride', text: 'Export GPX at the end to keep your route or upload it to Strava or Komoot.' },
      ]}
    />
  </Section>

  <Section
    id="cycling-speeds"
    eyebrow="Benchmarks"
    title="How Fast Do Cyclists Ride?"
    intro="Speeds vary hugely with terrain, wind and bike, but these typical figures help you place your number."
  >
    <DataTable
      caption="Typical cycling speeds"
      head={['Rider', 'Typical speed']}
      rows={[
        ['Relaxed city or leisure riding', '12–18 km/h (7–11 mph)'],
        ['Commuting on a road or hybrid bike', '18–25 km/h (11–16 mph)'],
        ['E-bike, EU (pedelec)', 'Assistance stops at 25 km/h (15.5 mph)'],
        ['E-bike, US Class 1 & 2', 'Assistance up to 20 mph (32 km/h)'],
        ['E-bike, US Class 3', 'Assistance up to 28 mph (45 km/h)'],
        ['Fit club cyclist, solo on the flat', '28–35 km/h (17–22 mph)'],
        ['Tour de France stage average', 'Around 40 km/h (25 mph) and above'],
      ]}
      note="E-bike rules differ by country and state. Check local regulations."
    />
  </Section>

  <Section id="moving-average" eyebrow="Metrics" title="Moving Average, Moving Time and Trip Time">
    <div class="grid gap-4 md:grid-cols-3">
      <div class="card p-6">
        <h3 class="text-heading-md">Moving Average</h3>
        <p class="mt-2 text-sm leading-6 text-body">Distance divided by moving time. Red lights and coffee stops don’t drag it down — just like a bike computer.</p>
      </div>
      <div class="card p-6">
        <h3 class="text-heading-md">Moving Time</h3>
        <p class="mt-2 text-sm leading-6 text-body">Only counts while you’re faster than about 3 km/h, so it reflects the time you actually spent riding.</p>
      </div>
      <div class="card p-6">
        <h3 class="text-heading-md">Trip Time</h3>
        <p class="mt-2 text-sm leading-6 text-body">Total time since you pressed Start, including stops. Pause the trip to stop the clock completely.</p>
      </div>
    </div>
    <div class="prose-sr mt-8 max-w-3xl">
      <p>
        Riding an e-bike or e-scooter? Switch on the <strong>speed alert</strong> and set it to your local limit — for example 25 km/h for
        EU pedelecs. You’ll get a beep and a vibration the moment you cross it.
      </p>
      <p>
        Driving instead? The <a href="/car-speed-test/">car speed test</a> compares GPS with your dashboard and adds a windshield
        HUD. For running, skiing or anything else, use the general <a href="/speedometer/">online speedometer</a>.
      </p>
    </div>
  </Section>

  <Faq items={faqs} title="Bike Speed Test FAQ" />
  <RelatedTools current={tool.id} />
</BaseLayout>
