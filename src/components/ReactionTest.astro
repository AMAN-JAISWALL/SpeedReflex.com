---
import { Zap, Volume2, TriangleAlert, RotateCcw, Share2, Link2, Trash, Trophy } from '@lucide/astro';
import { ATTEMPTS_PER_SESSION, DIST, distX, distributionPaths, POPULATION } from '../lib/reaction';
import { getLocaleFromPath, type Locale } from '../lib/i18n';
import { getTranslations } from '../i18n';

interface Props {
  /** "audio" runs the same test with a beep as the signal and no visual change. */
  stimulus?: 'visual' | 'audio';
  locale?: Locale;
}

const { stimulus = 'visual', locale = getLocaleFromPath(Astro.url.pathname) } = Astro.props;
const t = getTranslations(locale);
const ui = t.toolUi.reactionTest;
const audio = stimulus === 'audio';
const signal = audio ? 'you hear the beep' : 'the panel turns blue';

const { line, area } = distributionPaths();
const axisTicks = [150, 200, 250, 300, 350, 400, 450, 500];
const xPct = (x: number) => `${(x / DIST.width) * 100}%`;
---

<reaction-test class="block" data-attempts={ATTEMPTS_PER_SESSION} data-stimulus={stimulus} data-i18n={JSON.stringify(ui)}>
  <div class="card overflow-hidden shadow-whisper">
    <div data-challenge hidden class="flex items-center gap-2 border-b border-hairline bg-link-soft/50 px-4 py-2.5 text-sm text-ink sm:px-5">
      <Trophy size={16} class="shrink-0 text-link" />
      <p data-challenge-text></p>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-b border-hairline px-4 py-3 sm:px-5">
      <div class="flex items-center gap-3">
        <span class="eyebrow">{ui.attempt}</span>
        <ol class="flex gap-1.5" aria-hidden="true" data-dots>
          {Array.from({ length: ATTEMPTS_PER_SESSION }, () => <li class="size-2 rounded-full bg-hairline-strong data-done:bg-ink" />)}
        </ol>
        <span class="text-sm text-body tabular-nums" data-attempt-label>0 of {ATTEMPTS_PER_SESSION}</span>
      </div>
      <dl class="flex items-center gap-5 text-sm">
        <div class="flex gap-1.5">
          <dt class="text-mute">{ui.average}</dt>
          <dd class="font-medium tabular-nums" data-live-avg>—</dd>
        </div>
        <div class="flex gap-1.5">
          <dt class="text-mute">{ui.best}</dt>
          <dd class="font-medium tabular-nums" data-live-best>—</dd>
        </div>
        <div class="hidden gap-1.5 md:flex">
          <dt class="text-mute">{ui.personalBest}</dt>
          <dd class="font-medium tabular-nums" data-pb>—</dd>
        </div>
      </dl>
    </div>

    <button
      type="button"
      data-stage
      data-state="idle"
      aria-describedby="rt-instructions"
      class:list={[
        'group relative flex min-h-[22rem] w-full cursor-pointer select-none flex-col items-center justify-center gap-3 bg-surface px-6 py-12 text-center text-ink outline-offset-[-6px] [-webkit-touch-callout:none] data-[state=early]:bg-error-soft data-[state=waiting]:bg-stage-wait data-[state=waiting]:text-white sm:min-h-[26rem] data-[state=done]:min-h-[15rem] sm:data-[state=done]:min-h-[16rem]',
        audio ? 'data-[state=go]:bg-stage-wait data-[state=go]:text-white' : 'data-[state=go]:bg-stage-go data-[state=go]:text-white',
      ]}
    >
      <span class="mb-2 hidden size-14 items-center justify-center rounded-full border border-hairline bg-canvas group-data-[state=idle]:flex">
        {audio ? <Volume2 size={24} stroke-width={1.75} /> : <Zap size={24} stroke-width={1.75} />}
      </span>
      <span class="mb-2 hidden size-14 items-center justify-center rounded-full border border-error/30 bg-surface text-error group-data-[state=early]:flex">
        <TriangleAlert size={24} stroke-width={1.75} />
      </span>
      <span data-stage-kicker class:list={['eyebrow group-data-[state=waiting]:text-white/70', audio ? 'group-data-[state=go]:text-white/70' : 'group-data-[state=go]:text-white/80']}>
        {audio ? ui.audioKicker : ui.visualKicker}
      </span>
      <span data-stage-title class="text-display-sm sm:text-display">{ui.tapToStart}</span>
      <span
        data-stage-sub
        class:list={['max-w-md text-base text-body group-data-[state=waiting]:text-white/75', audio ? 'group-data-[state=go]:text-white/75' : 'group-data-[state=go]:text-white/85']}
      >
        {audio ? ui.subAudioStart : ui.subVisualStart}
      </span>
    </button>

    <div data-summary hidden class="border-t border-hairline">
      <dl class="grid grid-cols-2 gap-px bg-hairline lg:grid-cols-4">
        <div class="bg-surface p-4 sm:p-5">
          <dt class="eyebrow">{ui.average}</dt>
          <dd class="mt-2 text-[1.625rem] font-semibold leading-8 tracking-[-0.04em] sm:text-heading-lg" data-sum-avg>—</dd>
          <dd class="mt-1 text-sm text-body" data-sum-tier>—</dd>
        </div>
        <div class="bg-surface p-4 sm:p-5">
          <dt class="eyebrow">{ui.best}</dt>
          <dd class="mt-2 text-[1.625rem] font-semibold leading-8 tracking-[-0.04em] sm:text-heading-lg" data-sum-best>—</dd>
          <dd class="mt-1 text-sm text-body" data-sum-worst>—</dd>
        </div>
        <div class="bg-surface p-4 sm:p-5">
          <dt class="eyebrow">{ui.median}</dt>
          <dd class="mt-2 text-[1.625rem] font-semibold leading-8 tracking-[-0.04em] sm:text-heading-lg" data-sum-median>—</dd>
          <dd class="mt-1 text-sm text-body">{ui.middleAttempt}</dd>
        </div>
        <div class="bg-surface p-4 sm:p-5">
          <dt class="eyebrow">{ui.consistency}</dt>
          <dd class="mt-2 text-[1.625rem] font-semibold leading-8 tracking-[-0.04em] sm:text-heading-lg" data-sum-sd>—</dd>
          <dd class="mt-1 text-sm text-body" data-sum-sd-label>—</dd>
        </div>
      </dl>

      <div class="grid gap-px border-t border-hairline bg-hairline lg:grid-cols-5">
        {
          audio ? (
            <figure class="bg-surface p-5 lg:col-span-3">
              <figcaption class="text-label text-ink">{ui.soundVsSight}</figcaption>
              <dl class="mt-4 grid gap-4">
                <div data-compare-visual-row hidden>
                  <div class="flex items-baseline justify-between gap-3 text-sm">
                    <dt class="text-body">{ui.yourLatestVisual}</dt>
                    <dd class="font-medium tabular-nums" data-compare-visual>—</dd>
                  </div>
                  <div class="mt-2 h-2 overflow-hidden rounded-full bg-hairline-soft" aria-hidden="true">
                    <span class="block h-full rounded-full bg-ink" data-compare-visual-bar />
                  </div>
                </div>
                <div>
                  <div class="flex items-baseline justify-between gap-3 text-sm">
                    <dt class="text-body">{ui.thisSoundTest}</dt>
                    <dd class="font-medium tabular-nums" data-compare-audio>—</dd>
                  </div>
                  <div class="mt-2 h-2 overflow-hidden rounded-full bg-hairline-soft" aria-hidden="true">
                    <span class="block h-full rounded-full bg-link" data-compare-audio-bar />
                  </div>
                </div>
              </dl>
              <p class="mt-4 text-sm text-body" data-compare-summary />
              <p class="mt-3 text-xs text-mute" data-compare-empty>
                <a href={locale === 'en' ? '/reaction-time-test/' : `/${locale}/reaction-time-test/`} class="font-medium text-link hover:text-link-deep">{ui.takeVisualTest}</a>
              </p>
            </figure>
          ) : (
            <figure class="bg-surface p-5 lg:col-span-3">
              <figcaption class="flex flex-wrap items-baseline justify-between gap-2">
                <span class="text-label text-ink">{ui.whereYouStand}</span>
                <span class="text-sm text-body" data-sum-percentile>—</span>
              </figcaption>
              {/* Labels are HTML, not SVG text, so they stay readable when the chart shrinks on phones. */}
              <div class="relative mt-4 pt-5" data-dist>
                <svg
                  viewBox={`0 0 ${DIST.width} ${DIST.base + 7}`}
                  class="block h-auto w-full overflow-visible text-ink"
                  role="img"
                  aria-label={`Modelled distribution of human reaction times, median ${POPULATION.medianMs} ms, with your average marked.`}
                >
                  <line x1={DIST.padX} x2={DIST.width - DIST.padX} y1={DIST.base} y2={DIST.base} class="stroke-hairline-strong" stroke-width="1" />
                  <path d={area} fill="currentColor" fill-opacity="0.08" />
                  <path d={line} fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
                  <line
                    x1={distX(POPULATION.medianMs)}
                    x2={distX(POPULATION.medianMs)}
                    y1={DIST.top}
                    y2={DIST.base}
                    class="stroke-hairline-strong"
                    stroke-width="1"
                  />
                  <g data-dist-marker class="text-link">
                    <line data-dist-line x1="0" x2="0" y1={DIST.top - 4} y2={DIST.base} stroke="currentColor" stroke-width="2" />
                    <circle data-dist-dot cx="0" cy={DIST.base} r="5" fill="currentColor" class="stroke-surface" stroke-width="2" />
                  </g>
                  <line data-dist-cross x1="0" x2="0" y1={DIST.top} y2={DIST.base} class="hidden stroke-mute" stroke-width="1" />
                </svg>
                <span data-dist-label class="pointer-events-none absolute top-0 -translate-x-1/2 whitespace-nowrap text-xs font-semibold text-ink" aria-hidden="true">
                  {ui.you}
                </span>
                <span class="pointer-events-none absolute bottom-2 text-[11px] text-mute" style={`left: ${xPct(distX(POPULATION.medianMs) + 6)}`} aria-hidden="true">
                  {ui.medianLabel} {POPULATION.medianMs}
                </span>
                <div
                  data-dist-tip
                  hidden
                  class="pointer-events-none absolute top-0 z-10 -translate-x-1/2 -translate-y-full whitespace-nowrap rounded-sm border border-hairline bg-surface px-2.5 py-1.5 text-xs shadow-float"
                >
                  <strong class="block text-sm font-semibold text-ink tabular-nums" data-dist-tip-value></strong>
                  <span class="text-mute" data-dist-tip-label></span>
                </div>
              </div>
              <div class="relative mt-1.5 h-4 font-mono text-[11px] text-mute" aria-hidden="true">
                {
                  axisTicks.map((t, i) => (
                    <span class:list={['absolute top-0 -translate-x-1/2', i % 2 === 0 && 'max-sm:hidden']} style={`left: ${xPct(distX(t))}`}>
                      {t}
                    </span>
                  ))
                }
              </div>
              <p class="mt-1 text-right text-[11px] text-mute" aria-hidden="true">{ui.msFaster}</p>
              <p class="mt-3 text-xs text-mute">
                {ui.percentileModelNote}
              </p>
            </figure>
          )
        }

        <div class="bg-surface p-5 lg:col-span-2">
          <p class="text-label text-ink">{ui.attempts}</p>
          <ol class="mt-4 space-y-3" data-sum-attempts></ol>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-3 border-t border-hairline bg-canvas px-4 py-4 sm:px-5">
        <button type="button" class="btn btn-md btn-primary" data-restart>
          <RotateCcw size={16} />
          {ui.tryAgain}
        </button>
        <button type="button" class="btn btn-md btn-secondary" data-share>
          <Share2 size={16} />
          {ui.shareResult}
        </button>
        <button type="button" class="btn btn-md btn-secondary" data-copy-challenge>
          <Link2 size={16} />
          {ui.copyChallengeLink}
        </button>
        <p class="text-sm text-body sm:ml-auto" data-sum-verdict></p>
      </div>
    </div>
  </div>

  <p id="rt-instructions" class="sr-only">
    {audio ? ui.srInstructionsAudio : ui.srInstructionsVisual}
  </p>
  <div class="sr-only" aria-live="polite" data-announce></div>
  <div aria-live="polite" class="pointer-events-none fixed inset-x-0 bottom-6 z-50 flex justify-center px-4">
    <p data-toast hidden class="rounded-pill bg-primary px-4 py-2 text-sm font-medium text-on-primary shadow-float"></p>
  </div>

  <section data-history hidden class="mt-6 card p-4 sm:p-6" aria-labelledby="rt-history-title">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h2 id="rt-history-title" class="text-heading-md">{ui.yourProgress}</h2>
        <p class="mt-1 text-sm text-body">{ui.progressSubtitle}</p>
      </div>
      <button type="button" class="btn btn-sm btn-ghost" data-clear-history>
        <Trash size={14} />
        {ui.clearHistory}
      </button>
    </div>
    <dl class="mt-5 grid grid-cols-3 gap-4 border-y border-hairline py-4 text-sm [&>div]:flex [&>div]:flex-col [&>div]:justify-between">
      <div>
        <dt class="text-mute">{ui.personalBest}</dt>
        <dd class="mt-1 text-heading-md" data-hist-pb>—</dd>
      </div>
      <div>
        <dt class="text-mute">{ui.best} {ui.average}</dt>
        <dd class="mt-1 text-heading-md" data-hist-best-avg>—</dd>
      </div>
      <div>
        <dt class="text-mute">{ui.sessions}</dt>
        <dd class="mt-1 text-heading-md" data-hist-count>—</dd>
      </div>
    </dl>
    <div data-hist-trend-wrap>
      <p class="mt-5 text-label text-ink">{ui.averagePerSession}</p>
      <div data-hist-trend tabindex="0" aria-label={ui.trendAria} class="relative mt-3 h-28 text-ink"></div>
    </div>
    <div class="mt-5 overflow-x-auto rounded-sm border border-hairline">
      <table class="data-table [&_td+td]:whitespace-nowrap">
        <caption class="sr-only">{ui.yourProgress}</caption>
        <thead>
          <tr>
            <th scope="col">{ui.tableWhen}</th>
            <th scope="col">{ui.tableAverage}</th>
            <th scope="col">{ui.tableBest}</th>
            <th scope="col">{audio ? ui.tableSpread : ui.tablePercentile}</th>
          </tr>
        </thead>
        <tbody data-hist-rows></tbody>
      </table>
    </div>
  </section>
</reaction-test>

<script>
  import '../scripts/reaction-test';
</script>
