---
// Layout for an English blog post: header, prose body (slot), optional FAQ and sources, then tools and more reading.
import { ArrowRight } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Section from './Section.astro';
import Faq from './Faq.astro';
import ToolCard from './ToolCard.astro';
import { BLOG_HREF, toolById } from '../lib/site';
import { articlePage, type Crumb, type FaqItem } from '../lib/schema';
import { blogHref, relatedPosts, type BlogPost } from '../lib/blog';

interface Props {
  post: BlogPost;
  faqs?: FaqItem[];
  sources?: { t: string; href?: string }[];
}

const { post, faqs = [], sources = [] } = Astro.props;
const href = blogHref(post.slug);
const crumbs: Crumb[] = [
  { name: 'Home', href: '/' },
  { name: 'Blog', href: BLOG_HREF },
  { name: post.h1, href },
];
const tools = post.tools.map((id) => {
  const tool = toolById(id);
  return { id: tool.id, href: tool.href, name: tool.name, summary: tool.summary };
});
const more = relatedPosts(post.slug);
const dateLabel = new Date(`${post.modified}T12:00:00Z`).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<BaseLayout
  title={post.title}
  description={post.description}
  ogType="article"
  locale="en"
  localized={false}
  published={post.published}
  modified={post.modified}
  jsonLd={articlePage({
    href,
    headline: post.h1,
    description: post.description,
    datePublished: post.published,
    dateModified: post.modified,
    crumbs,
    faq: faqs,
    type: 'BlogPosting',
    keywords: post.keywords,
  })}
>
  <article>
    <header class="relative isolate overflow-hidden border-b border-hairline">
      <div class="mesh pointer-events-none absolute -top-48 left-1/2 -z-10 h-[30rem] w-[56rem] -translate-x-1/2 opacity-40 dark:opacity-25" aria-hidden="true"></div>
      <div class="shell pb-12 pt-6 sm:pb-16 sm:pt-8">
        <Breadcrumbs crumbs={crumbs} />
        <div class="mt-6 max-w-3xl">
          <p class="eyebrow">Blog · {post.topic}</p>
          <h1 class="mt-3 text-display-sm sm:text-display">{post.h1}</h1>
          <p class="mt-4 text-lg leading-7 text-body">{post.excerpt}</p>
          <p class="mt-4 text-sm text-mute">
            SpeedReflex · Updated <time datetime={post.modified}>{dateLabel}</time> · {post.readMinutes} min read
          </p>
        </div>
      </div>
    </header>

    <div class="border-b border-hairline py-12 sm:py-16">
      <div class="shell">
        <div class="article-prose prose-sr max-w-3xl">
          <slot />
        </div>
      </div>
    </div>

    {faqs.length > 0 && <Faq items={faqs} title="Frequently Asked Questions" />}

    {
      sources.length > 0 && (
        <Section id="sources" eyebrow="References" title="Sources">
          <ol class="prose-sr max-w-3xl list-decimal pl-5 text-sm marker:text-faint">
            {sources.map((s) => (
              <li>
                {s.href ? (
                  <a href={s.href} rel="noopener" target="_blank">
                    {s.t}
                  </a>
                ) : (
                  s.t
                )}
              </li>
            ))}
          </ol>
        </Section>
      )
    }
  </article>

  <Section id="tools" eyebrow="Try it" title="Free Tools for This Topic">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {tools.map((tool) => <ToolCard tool={tool} />)}
    </div>
  </Section>

  <Section id="more-articles" eyebrow="Keep reading" title="More From the Blog">
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        more.map((p) => (
          <li>
            <a href={blogHref(p.slug)} class="group card flex h-full flex-col p-6 transition-[border-color,box-shadow] duration-200 hover:border-hairline-strong hover:shadow-float">
              <span class="eyebrow">{p.topic}</span>
              <h3 class="mt-3 text-heading-md">{p.h1}</h3>
              <p class="mt-2 flex-1 text-sm leading-6 text-body">{p.excerpt}</p>
              <span class="mt-6 inline-flex items-center gap-1 text-sm font-medium text-ink">
                Read article <ArrowRight size={14} class="transition-transform duration-200 group-hover:translate-x-0.5 motion-reduce:transition-none" />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>
</BaseLayout>
