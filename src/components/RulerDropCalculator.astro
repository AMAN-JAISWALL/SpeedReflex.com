---
import { Plus, RotateCcw } from '@lucide/astro';
import { rulerRating, rulerTimeMs } from '../lib/ruler';

// Server render shows a 15 cm catch; the script takes over from there.
const initialCm = 15;
const initialMs = Math.round(rulerTimeMs(initialCm));
---

<ruler-drop class="block">
  <div class="card overflow-hidden shadow-whisper">
    <div class="grid grid-cols-1 lg:grid-cols-2">
      <form class="grid content-start gap-6 p-5 sm:p-6" data-form>
        <div>
          <div class="flex items-center justify-between gap-3">
            <label for="rd-distance" class="text-label text-ink">Distance the ruler fell</label>
            <div class="segmented" role="group" aria-label="Distance unit" data-units>
              <button type="button" data-unit="cm" aria-pressed="true">cm</button>
              <button type="button" data-unit="in" aria-pressed="false">inches</button>
            </div>
          </div>
          <div class="mt-3 flex items-center gap-3">
            <input
              id="rd-distance"
              name="distance"
              type="number"
              inputmode="decimal"
              min="0.5"
              max="100"
              step="0.1"
              value={initialCm}
              autocomplete="off"
              data-distance
              aria-describedby="rd-distance-help"
              class="h-11 w-28 rounded-sm border border-hairline px-3 text-base tabular-nums focus-visible:border-link"
            />
            <input
              type="range"
              min="1"
              max="30"
              step="0.5"
              value={initialCm}
              aria-label="Distance slider"
              data-distance-range
              class="h-11 min-w-0 flex-1 accent-ink"
            />
          </div>
          <p id="rd-distance-help" class="mt-2 text-xs text-mute">Read the ruler at the top edge of your thumb, where you caught it.</p>
        </div>

        <div>
          <p class="text-label text-ink">Your drops</p>
          <p class="mt-1 text-sm text-body">Add each catch to average several drops — five to ten gives a reliable score.</p>
          <div class="mt-3 flex flex-wrap gap-2">
            <button type="button" class="btn btn-sm btn-primary" data-add>
              <Plus size={14} /> Add this drop
            </button>
            <button type="button" class="btn btn-sm btn-secondary" data-clear disabled>
              <RotateCcw size={14} /> Clear
            </button>
          </div>
          <ol class="mt-4 flex flex-wrap gap-2 text-sm tabular-nums" data-trials aria-label="Recorded drops"></ol>
        </div>
      </form>

      <div class="border-t border-hairline bg-canvas p-5 sm:p-6 lg:border-l lg:border-t-0" aria-live="polite">
        <p class="eyebrow">Reaction time</p>
        <p class="mt-2 flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <span class="text-[3rem] font-semibold leading-none tracking-[-0.05em] tabular-nums" data-ms>{initialMs} ms</span>
          <span class="text-sm text-body" data-seconds>{(initialMs / 1000).toFixed(3)} s</span>
        </p>
        <p class="mt-3 text-sm text-body">
          Rating: <strong class="font-medium text-ink" data-rating>{rulerRating(initialCm)}</strong>
          <span class="text-mute"> · 16–19-year-old norms</span>
        </p>

        <dl class="mt-6 grid grid-cols-3 gap-4 border-t border-hairline pt-5" data-summary hidden>
          <div>
            <dt class="text-sm text-body">Average</dt>
            <dd class="mt-1 text-heading-md tabular-nums" data-avg>–</dd>
          </div>
          <div>
            <dt class="text-sm text-body">Best</dt>
            <dd class="mt-1 text-heading-md tabular-nums" data-best>–</dd>
          </div>
          <div>
            <dt class="text-sm text-body">Drops</dt>
            <dd class="mt-1 text-heading-md tabular-nums" data-count>0</dd>
          </div>
        </dl>

        <p class="mt-5 border-t border-hairline pt-4 text-sm leading-6 text-body" data-note>
          A 15 cm catch means the ruler fell for {initialMs} ms before your fingers closed.
        </p>
      </div>
    </div>
  </div>
</ruler-drop>

<script>
  import '../scripts/ruler-drop';
</script>
