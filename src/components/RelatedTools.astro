---
import Section from './Section.astro';
import ToolCard from './ToolCard.astro';
import { relatedFor, toolById, type ToolId } from '../lib/site';
import { getLocaleFromPath, getLocalizedPath, type Locale } from '../lib/i18n';
import { getTranslations } from '../i18n';

interface Props {
  current: ToolId;
  locale?: Locale;
}

const { current, locale = getLocaleFromPath(Astro.url.pathname) } = Astro.props;
const t = getTranslations(locale);
// English pages may append English-only tools; localized pages only ever list tools that exist in their locale.
const tools = relatedFor(toolById(current), locale).map((orig) => ({
  id: orig.id,
  href: getLocalizedPath(orig.href, locale),
  name: t.tools[orig.id]?.name ?? orig.name,
  summary: t.tools[orig.id]?.summary ?? orig.summary,
}));
---

<Section id="more-tests" eyebrow={t.nav.relatedToolsTitle} title={t.nav.relatedToolsIntro}>
  <div class:list={['grid gap-4 sm:grid-cols-2', tools.length === 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3']}>
    {tools.map((tool) => <ToolCard tool={tool} />)}
  </div>
</Section>
