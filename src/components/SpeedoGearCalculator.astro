---
import { drivenGearTeeth, gearErrorPct, revsPerMile } from '../lib/tires';

// Server render: 3.73 axle, 32.7" tire (the 285/70R17 above), 8-tooth drive gear.
const initial = { axle: 3.73, diameter: 32.7, drive: 8 };
const exact = drivenGearTeeth(initial.axle, initial.drive, initial.diameter);
const nearest = Math.round(exact);
const err = gearErrorPct(exact, nearest);

const field = 'mt-2 h-11 w-full rounded-sm border border-hairline px-3 text-base tabular-nums focus-visible:border-link';
---

<speedo-gear class="block">
  <div class="card overflow-hidden shadow-whisper">
    <div class="grid grid-cols-1 lg:grid-cols-2">
      <form class="grid content-start gap-4 p-5 sm:grid-cols-2 sm:p-6" data-form>
        <div>
          <label for="sg-axle" class="text-label text-ink">Axle (rear end) ratio</label>
          <input id="sg-axle" type="number" inputmode="decimal" min="1" max="8" step="0.01" value={initial.axle} autocomplete="off" data-axle class={field} />
        </div>
        <div>
          <label for="sg-diameter" class="text-label text-ink">Tire diameter (in)</label>
          <input id="sg-diameter" type="number" inputmode="decimal" min="15" max="60" step="0.1" value={initial.diameter} autocomplete="off" data-diameter class={field} />
        </div>
        <div>
          <label for="sg-drive" class="text-label text-ink">Drive gear teeth</label>
          <input id="sg-drive" type="number" inputmode="numeric" min="1" max="30" step="1" value={initial.drive} autocomplete="off" data-drive class={field} />
        </div>
        <div>
          <label for="sg-current" class="text-label text-ink">Current driven gear <span class="font-normal text-mute">(optional)</span></label>
          <input id="sg-current" type="number" inputmode="numeric" min="1" max="60" step="1" placeholder="e.g. 20" autocomplete="off" data-current class={field} />
        </div>
      </form>

      <div class="border-t border-hairline bg-canvas p-5 sm:p-6 lg:border-l lg:border-t-0" aria-live="polite">
        <p class="eyebrow">Driven gear you need</p>
        <p class="mt-2 flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <span class="text-[3rem] font-semibold leading-none tracking-[-0.05em] tabular-nums" data-nearest>{nearest}</span>
          <span class="text-sm text-body">teeth · exact <span class="tabular-nums" data-exact>{exact.toFixed(2)}</span></span>
        </p>
        <p class="mt-3 text-sm text-body">Tire revolutions per mile: <strong class="font-medium text-ink tabular-nums" data-rpm>{Math.round(revsPerMile(initial.diameter))}</strong></p>
        <p class="mt-5 border-t border-hairline pt-4 text-sm leading-6 text-body" data-result>
          A {nearest}-tooth driven gear reads {Math.abs(err).toFixed(1)}% {err > 0 ? 'high' : 'low'}. Based on 1001 cable turns per mile.
        </p>
      </div>
    </div>
  </div>
</speedo-gear>

<script>
  import '../scripts/tire-speedo';
</script>
