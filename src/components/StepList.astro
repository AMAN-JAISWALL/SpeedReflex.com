---
interface Props {
  steps: { title: string; text: string }[];
}

const { steps } = Astro.props;
---

<ol class:list={['grid gap-4 sm:grid-cols-2', steps.length > 3 ? 'lg:grid-cols-4' : 'lg:grid-cols-3']}>
  {
    steps.map((s, i) => (
      <li class="card p-6">
        <span class="font-mono text-xs text-mute">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="mt-4 text-heading-md">{s.title}</h3>
        <p class="mt-2 text-sm leading-6 text-body">{s.text}</p>
      </li>
    ))
  }
</ol>
