---
import { TriangleAlert, Lock } from '@lucide/astro';

interface Props {
  tone?: 'warning' | 'info';
  title: string;
}

const { tone = 'info', title } = Astro.props;
const Icon = tone === 'warning' ? TriangleAlert : Lock;
---

<aside
  class:list={[
    'flex gap-3 rounded-md border p-4 text-sm leading-6',
    tone === 'warning' ? 'border-warning/40 bg-warning-soft text-ink' : 'border-hairline bg-surface text-body',
  ]}
>
  <Icon size={18} class:list={['mt-0.5 shrink-0', tone === 'warning' ? 'text-warning-deep' : 'text-ink']} />
  <div>
    <p class="font-medium text-ink">{title}</p>
    <p class="mt-1 text-body"><slot /></p>
  </div>
</aside>
