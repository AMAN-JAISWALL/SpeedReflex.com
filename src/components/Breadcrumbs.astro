---
import type { Crumb } from '../lib/schema';

interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
const last = crumbs.length - 1;
---

<nav aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-x-1.5 gap-y-1 text-sm text-mute">
    {
      crumbs.map((c, i) =>
        i < last ? (
          <>
            <li>
              <a href={c.href} class="transition-colors hover:text-ink">
                {c.name}
              </a>
            </li>
            <li aria-hidden="true">/</li>
          </>
        ) : (
          <li aria-current="page" class="text-body">
            {c.name}
          </li>
        ),
      )
    }
  </ol>
</nav>
