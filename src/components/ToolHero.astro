---
import { Check } from '@lucide/astro';
import Breadcrumbs from './Breadcrumbs.astro';
import type { Crumb } from '../lib/schema';

interface Props {
  crumbs: Crumb[];
  eyebrow: string;
  title: string;
  lede: string;
  features?: string[];
}

const { crumbs, eyebrow, title, lede, features = [] } = Astro.props;
---

<section class="relative isolate overflow-hidden border-b border-hairline">
  <div class="mesh pointer-events-none absolute -top-48 left-1/2 -z-10 h-[30rem] w-[56rem] -translate-x-1/2 opacity-50 dark:opacity-30" aria-hidden="true"></div>
  <div class="shell pb-12 pt-6 sm:pb-16 sm:pt-8">
    <Breadcrumbs crumbs={crumbs} />
    <div class="mt-6 max-w-3xl">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="mt-3 text-display-sm sm:text-display">{title}</h1>
      <p class="mt-4 text-lg leading-7 text-body">{lede}</p>
    </div>
    <div class="mt-8">
      <slot />
    </div>
    {
      features.length > 0 && (
        <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm text-body">
          {features.map((f) => (
            <li class="inline-flex items-center gap-1.5">
              <Check size={14} class="text-link" />
              {f}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>
