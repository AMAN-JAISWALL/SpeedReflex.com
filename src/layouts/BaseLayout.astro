---
import { Font } from 'astro:assets';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE } from '../lib/site';
import { organization, website } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  /** Page-specific schema.org nodes; the organization and website nodes are always added. */
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  ogType?: 'website' | 'article';
}

const { title, description, jsonLd = [], noindex = false, ogType = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const ogImage = new URL('/og.png', Astro.site ?? SITE.url).href;
const ogImageAlt = 'SpeedReflex — reaction time tests and GPS speedometers';
const graph = JSON.stringify({ '@context': 'https://schema.org', '@graph': [organization(), website(), ...jsonLd] }).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <meta name="theme-color" content="#fafafa" />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        var mq = window.matchMedia('(prefers-color-scheme: dark)');
        function apply(pref) {
          if (!pref) {
            try {
              pref = localStorage.getItem('sr-theme');
            } catch (e) {}
          }
          pref = pref === 'light' || pref === 'dark' ? pref : 'system';
          var dark = pref === 'dark' || (pref === 'system' && mq.matches);
          d.dataset.theme = dark ? 'dark' : 'light';
          d.dataset.themePref = pref;
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', dark ? '#0a0a0a' : '#fafafa');
        }
        apply();
        mq.addEventListener('change', function () {
          apply(d.dataset.themePref);
        });
        // Another tab changed the theme, or this page came back from the back/forward cache.
        window.addEventListener('storage', function (e) {
          if (e.key === 'sr-theme' || e.key === null) apply();
        });
        window.addEventListener('pageshow', function (e) {
          if (e.persisted) apply();
        });
        window.__srApplyTheme = apply;
      })();
    </script>

    <link rel="icon" type="image/png" href="/favicon-96x96.png?v=1.1" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=1.1" />
    <link rel="shortcut icon" href="/favicon.ico?v=1.1" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=1.1" />
    <meta name="apple-mobile-web-app-title" content="SpeedReflex" />
    <link rel="manifest" href="/site.webmanifest?v=1.1" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-geist-mono" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <meta name="generator" content={Astro.generator} />

    {!noindex && <script type="application/ld+json" set:html={graph} />}
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="btn btn-sm btn-primary sr-only focus-visible:not-sr-only focus-visible:fixed focus-visible:left-4 focus-visible:top-3 focus-visible:z-50"
    >
      Skip to Content
    </a>
    <SiteHeader />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
