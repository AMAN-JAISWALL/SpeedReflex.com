---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolHero from '../components/ToolHero.astro';
import Speedometer from '../components/Speedometer.astro';
import Section from '../components/Section.astro';
import StepList from '../components/StepList.astro';
import DataTable from '../components/DataTable.astro';
import Callout from '../components/Callout.astro';
import Faq from '../components/Faq.astro';
import RelatedTools from '../components/RelatedTools.astro';
import { toolById } from '../lib/site';
import { toolCrumbs, toolPage } from '../lib/schema';
import { getLocalizedPath, type Locale } from '../lib/i18n';
import { getTranslations } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const p = t.pages.car;
const tool = toolById('car');

const localizedHref = getLocalizedPath(tool.href, locale);
const crumbs = toolCrumbs(tool, locale, {
  home: t.nav.home,
  tool: t.tools.car.name,
});

const r39 = [30, 50, 80, 100, 120].map((v) => [`${v} km/h`, `${v}–${Math.floor(v * 1.1 + 4)} km/h`]);
---

<BaseLayout
  title={p.title}
  description={p.description}
  jsonLd={toolPage(tool, p.title, p.description, p.faqs, locale, localizedHref, crumbs)}
  locale={locale}
>
  <ToolHero
    crumbs={crumbs}
    eyebrow={p.eyebrow}
    title={p.heroTitle}
    lede={p.lede}
    features={p.features}
  >
    <Speedometer preset="car" locale={locale} />
    <div class="mt-4 max-w-3xl">
      <Callout tone="warning" title={p.safetyTitle}>
        {p.safetyIntro}
      </Callout>
    </div>
  </ToolHero>

  <Section id="how-to" eyebrow={p.howItWorksEyebrow} title={p.howItWorksTitle}>
    <StepList
      steps={p.steps.map((s) => ({
        title: s.t,
        text: s.d,
      }))}
    />
  </Section>

  <Section
    id="gps-vs-dashboard"
    eyebrow={p.r39Eyebrow}
    title={p.r39Title}
    intro={p.r39Intro}
  >
    <DataTable
      caption={p.r39Title}
      head={[p.tableActual, p.tablePermitted]}
      rows={r39}
      note={p.r39Prose}
    />
  </Section>

  <Section id="hud" eyebrow={p.hudEyebrow} title={p.hudTitle}>
    <div class="grid gap-10 lg:grid-cols-2">
      <div class="prose-sr">
        <p>{p.hudIntro}</p>
        <p>{p.hudProse}</p>
      </div>
      <div class="flex items-center justify-center rounded-md border border-hairline bg-black p-10" aria-hidden="true">
        <div class="text-center text-white" style="transform: scaleX(-1)">
          <p class="text-[5rem] font-semibold leading-none tracking-[-0.05em] tabular-nums">88</p>
          <p class="mt-2 font-mono text-sm text-white/60">KM/H</p>
        </div>
      </div>
    </div>
  </Section>

  <Section
    id="safety"
    eyebrow={p.safetyEyebrow}
    title={p.safetyTitle}
    intro={p.safetyIntro}
  >
    <div class="grid gap-4 sm:grid-cols-2">
      {
        p.safetyPoints.map((pt) => (
          <div class="card p-6">
            <h3 class="text-heading-md">{pt.title}</h3>
            <p class="mt-2 text-sm leading-6 text-body">{pt.text}</p>
          </div>
        ))
      }
    </div>
    <div class="prose-sr mt-8 max-w-3xl">
      <p>
        <a href={getLocalizedPath('/stopping-distance-calculator/', locale)}>
          {t.tools.stopping.name}
        </a>.
      </p>
    </div>
  </Section>

  <Faq items={p.faqs} title={p.faqTitle} />
  <RelatedTools current={tool.id} locale={locale} />
</BaseLayout>
