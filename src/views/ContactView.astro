---
import { Mail, Bug, HelpCircle, ShieldCheck, Clock, Send, Copy } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE } from '../lib/site';
import { webPage, type Crumb } from '../lib/schema';
import { getLocalizedPath, type Locale } from '../lib/i18n';
import { getTranslations } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const p = t.pages.contact;

const localizedHref = getLocalizedPath('/contact/', locale);
const crumbs: Crumb[] = [
  { name: t.nav.home, href: getLocalizedPath('/', locale) },
  { name: t.nav.contactUs, href: localizedHref },
];

const channelIcons = [Mail, Bug, HelpCircle, ShieldCheck];
const channels = p.channels.map((c, i) => ({
  icon: channelIcons[i % channelIcons.length],
  title: c.title,
  desc: c.desc,
  email: SITE.contactEmail,
}));
---

<BaseLayout
  title={p.title}
  description={p.description}
  jsonLd={webPage({ href: localizedHref, name: p.title, description: p.description, crumbs, faq: p.faqs, type: 'ContactPage', locale })}
  locale={locale}
>
  <section class="border-b border-hairline">
    <div class="shell max-w-3xl pb-16 pt-6 sm:pb-24 sm:pt-8">
      <Breadcrumbs crumbs={crumbs} />
      <p class="eyebrow mt-10">{p.eyebrow}</p>
      <h1 class="mt-3 text-display-sm sm:text-display">{p.heroTitle}</h1>
      <p class="mt-6 text-lg leading-8 text-body">{p.heroText}</p>
    </div>
  </section>

  <!-- Channels Grid -->
  <section class="border-b border-hairline" aria-labelledby="channels-heading">
    <div class="shell py-16 sm:py-24">
      <h2 id="channels-heading" class="text-heading-lg">{p.channelsHeading}</h2>
      <p class="mt-2 text-sm text-body">{p.channelsSubtitle}</p>

      <div class="mt-10 grid gap-px overflow-hidden rounded-md border border-hairline bg-hairline sm:grid-cols-2 lg:grid-cols-4">
        {
          channels.map((c) => (
            <div class="flex flex-col justify-between bg-surface p-6">
              <div>
                <span class="flex size-10 items-center justify-center rounded-sm border border-hairline bg-canvas">
                  <c.icon size={20} class="text-ink" />
                </span>
                <h3 class="mt-4 text-heading-md">{c.title}</h3>
                <p class="mt-2 text-sm leading-6 text-body">{c.desc}</p>
              </div>
              <div class="mt-6 border-t border-hairline pt-4">
                <a
                  href={`mailto:${c.email}?subject=${encodeURIComponent(c.title)}`}
                  class="text-sm font-medium text-link transition-colors hover:text-link-deep"
                >
                  {c.email} &rarr;
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Contact Form & Troubleshooting Guidance -->
  <section class="border-b border-hairline" aria-labelledby="form-heading">
    <div class="shell grid gap-12 py-16 sm:py-24 lg:grid-cols-12">
      <!-- Form Column -->
      <div class="lg:col-span-7">
        <h2 id="form-heading" class="text-heading-lg">{p.formHeading}</h2>
        <p class="mt-2 text-sm text-body">{p.formSubtitle}</p>

        <form id="contact-form" class="mt-8 grid gap-5">
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="contact-name" class="block text-sm font-medium text-ink">
                {p.formNameLabel} <span class="text-mute">{p.formNameOptional}</span>
              </label>
              <input
                type="text"
                id="contact-name"
                name="name"
                autocomplete="name"
                class="mt-1.5 w-full rounded-sm border border-hairline bg-surface px-3 py-2 text-sm text-ink placeholder:text-mute focus:border-link focus:outline-none"
              />
            </div>
            <div>
              <label for="contact-email" class="block text-sm font-medium text-ink">
                {p.formEmailLabel} <span class="text-error">*</span>
              </label>
              <input
                type="email"
                id="contact-email"
                name="email"
                required
                autocomplete="email"
                class="mt-1.5 w-full rounded-sm border border-hairline bg-surface px-3 py-2 text-sm text-ink placeholder:text-mute focus:border-link focus:outline-none"
              />
            </div>
          </div>

          <div>
            <label for="contact-topic" class="block text-sm font-medium text-ink">
              {p.formTopicLabel} <span class="text-error">*</span>
            </label>
            <select
              id="contact-topic"
              name="topic"
              required
              class="mt-1.5 w-full rounded-sm border border-hairline bg-surface px-3 py-2 text-sm text-ink focus:border-link focus:outline-none"
            >
              {p.formTopics.map((top) => <option value={top.value}>{top.label}</option>)}
            </select>
          </div>

          <div>
            <label for="contact-subject" class="block text-sm font-medium text-ink">
              {p.formSubjectLabel} <span class="text-error">*</span>
            </label>
            <input
              type="text"
              id="contact-subject"
              name="subject"
              required
              placeholder={p.formSubjectPlaceholder}
              class="mt-1.5 w-full rounded-sm border border-hairline bg-surface px-3 py-2 text-sm text-ink placeholder:text-mute focus:border-link focus:outline-none"
            />
          </div>

          <div>
            <label for="contact-message" class="block text-sm font-medium text-ink">
              {p.formMessageLabel} <span class="text-error">*</span>
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows={5}
              required
              placeholder={p.formMessagePlaceholder}
              class="mt-1.5 w-full rounded-sm border border-hairline bg-surface px-3 py-2 text-sm text-ink placeholder:text-mute focus:border-link focus:outline-none"
            ></textarea>
          </div>

          <div class="flex flex-wrap items-center gap-3 pt-2">
            <button type="submit" class="btn btn-md btn-primary">
              <Send size={16} /> {p.btnSend}
            </button>
            <button type="button" id="copy-btn" class="btn btn-md btn-secondary">
              <Copy size={16} /> {p.btnCopy}
            </button>
          </div>

          <div id="form-feedback" class="hidden rounded-sm border border-hairline p-4 text-sm" role="status"></div>
        </form>
      </div>

      <!-- Guidelines Column -->
      <div class="lg:col-span-5 lg:pl-6">
        <div class="rounded-md border border-hairline bg-surface p-6 sm:p-8">
          <div class="flex items-center gap-2 text-label text-ink">
            <Clock size={16} class="text-mute" />
            <span>{p.responseTimeHeading}</span>
          </div>
          <p class="mt-3 text-sm leading-6 text-body">
            {p.responseTimeBody}
          </p>

          <h3 class="mt-6 text-heading-md">{p.glitchTipsHeading}</h3>
          <p class="mt-2 text-sm leading-6 text-body">
            {p.glitchTipsIntro}
          </p>
          <ul class="prose-sr mt-4 space-y-2 text-sm">
            {p.glitchTips.map((tip) => <li>{tip}</li>)}
          </ul>

          <div class="mt-8 border-t border-hairline pt-6">
            <p class="text-xs uppercase tracking-wider text-mute">{p.quickLegalTitle}</p>
            <div class="mt-3 flex flex-wrap gap-x-4 gap-y-2 text-sm">
              <a href={getLocalizedPath('/about/', locale)} class="text-link hover:underline">{t.nav.about}</a>
              <a href={getLocalizedPath('/privacy/', locale)} class="text-link hover:underline">{t.nav.privacyPolicy}</a>
              <a href={getLocalizedPath('/terms/', locale)} class="text-link hover:underline">{t.nav.termsConditions}</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Faq items={p.faqs} title={p.faqTitle} />

  <CtaBand
    title={p.ctaTitle}
    text={p.ctaText}
    primary={{ href: getLocalizedPath('/reaction-time-test/', locale), label: p.ctaPrimary }}
    secondary={{ href: getLocalizedPath('/speedometer/', locale), label: p.ctaSecondary }}
  />
</BaseLayout>
