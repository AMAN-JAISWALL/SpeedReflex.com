---
// English-only page: ruler drop test calculator, chart and norms.
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolHero from '../components/ToolHero.astro';
import RulerDropCalculator from '../components/RulerDropCalculator.astro';
import Section from '../components/Section.astro';
import StepList from '../components/StepList.astro';
import DataTable from '../components/DataTable.astro';
import Faq from '../components/Faq.astro';
import RelatedTools from '../components/RelatedTools.astro';
import { toolById } from '../lib/site';
import { toolCrumbs, toolPage, type FaqItem } from '../lib/schema';
import { CM_PER_IN, RULER_NORMS, rulerTimeMs } from '../lib/ruler';

const tool = toolById('ruler');
const title = 'Ruler Drop Test: Reaction Time Calculator & Chart (cm/in)';
const description =
  'Do the ruler drop test for reaction time, then convert your catch distance in cm or inches into milliseconds. Includes the formula, a full chart and norms.';
const crumbs = toolCrumbs(tool, 'en');

const ms = (cm: number) => `${Math.round(rulerTimeMs(cm))} ms`;
const cmRows = Array.from({ length: 15 }, (_, i) => (i + 1) * 2).map((cm) => [`${cm} cm`, ms(cm), `${(rulerTimeMs(cm) / 1000).toFixed(3)} s`]);
const inRows = Array.from({ length: 12 }, (_, i) => i + 1).map((inch) => [
  `${inch} in`,
  ms(inch * CM_PER_IN),
  `${(rulerTimeMs(inch * CM_PER_IN) / 1000).toFixed(3)} s`,
]);

let lower = 0;
const normRows = RULER_NORMS.map((n) => {
  const range = n.maxCm === Infinity ? `> ${lower} cm` : lower === 0 ? `< ${n.maxCm} cm` : `${lower}–${n.maxCm} cm`;
  const time = n.maxCm === Infinity ? `> ${ms(lower)}` : lower === 0 ? `< ${ms(n.maxCm)}` : `${Math.round(rulerTimeMs(lower))}–${ms(n.maxCm)}`;
  const inches = n.maxCm === Infinity ? `> ${(lower / CM_PER_IN).toFixed(1)} in` : lower === 0 ? `< ${(n.maxCm / CM_PER_IN).toFixed(1)} in` : `${(lower / CM_PER_IN).toFixed(1)}–${(n.maxCm / CM_PER_IN).toFixed(1)} in`;
  lower = n.maxCm;
  return [n.label, range, inches, time];
});

const steps = [
  { title: 'Get Into Position', text: 'Sit with your forearm resting on a table and your hand hanging over the edge. Hold your thumb and index finger about 3 cm (1 in) apart.' },
  { title: 'Line Up the Ruler', text: 'Your partner holds a 30 cm (12 in) ruler vertically between your fingers, with the zero mark level with the top of your thumb.' },
  { title: 'Catch It', text: 'Without warning, your partner lets go. Pinch the ruler as fast as you can — watch the ruler, not your partner’s hand.' },
  { title: 'Read and Repeat', text: 'Read the mark at the top of your thumb. Repeat five to ten times with random delays and enter each catch above.' },
];

const faqs: FaqItem[] = [
  {
    q: 'What does the ruler drop test measure?',
    a: 'Simple visual reaction time: how long it takes you to see the ruler start to fall and close your fingers on it. The distance it falls before you catch it is converted into time using the physics of free fall.',
  },
  {
    q: 'How do you calculate reaction time from a ruler drop?',
    a: 'Use t = √(2d ÷ g), with d in metres and g = 9.81 m/s². A 20 cm catch is √(2 × 0.20 ÷ 9.81) = 0.202 s, or 202 ms. In inches, use g = 386 in/s²: a 6-inch catch is √(12 ÷ 386) ≈ 0.176 s.',
  },
  {
    q: 'What is a good ruler drop test score?',
    a: 'On the widely used norms for 16–19-year-olds, a catch under 7.5 cm (about 124 ms) is excellent, 7.5–15.9 cm is above average, 15.9–20.4 cm is average, 20.4–28 cm is below average and anything over 28 cm is poor.',
  },
  {
    q: 'Why are ruler drop times faster than online reaction tests?',
    a: 'There is no screen refresh, mouse or touchscreen in the way, and a pinch is a tiny movement. Online tests add tens of milliseconds of hardware delay, so the same person may score about 180 ms with a ruler and 250 ms on a screen.',
  },
  {
    q: 'What if I catch the ruler past 30 cm?',
    a: 'A full 30 cm (12 in) fall takes about 247 ms, so slower reactions run off the end of the ruler. Use a longer ruler or a metre stick, or take the <a href="/reaction-time-test/">online reaction time test</a> instead.',
  },
  {
    q: 'Can I do the ruler drop test by myself?',
    a: 'Not properly — if you drop the ruler yourself you know exactly when it will fall, so you are timing anticipation rather than reaction. You need a partner who varies the delay, or a computer test with a random delay.',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={toolPage(tool, title, description, faqs, 'en', tool.href, crumbs)}
  locale="en"
  localized={false}
>
  <ToolHero
    crumbs={crumbs}
    eyebrow="Reflex test · No screen needed"
    title="Ruler Drop Test"
    lede="The ruler drop test measures your reaction time with nothing more than a ruler and a partner. Enter where you caught it, in centimetres or inches, and this calculator converts the distance into a reaction time in milliseconds using the physics of free fall."
    features={['Centimetres or inches', 'Average up to 10 drops', 'Rating against PE norms', 'Full conversion chart', 'Works offline']}
  >
    <RulerDropCalculator />
  </ToolHero>

  <Section id="how-to" eyebrow="How it works" title="How to Do the Ruler Drop Test" intro="Testing reaction time with a ruler takes two people, a 30 cm (12 inch) ruler and about two minutes.">
    <StepList steps={steps} />
    <div class="prose-sr mt-8 max-w-3xl">
      <p>
        Your partner should change the wait before each drop — anywhere from one to five seconds — so you can’t guess the moment. Use the
        same hand every time, and do a couple of practice catches first. Average at least five drops: single catches vary a lot, and the
        average is the number that means something.
      </p>
    </div>
  </Section>

  <Section id="formula" eyebrow="Physics" title="The Ruler Drop Test Formula" intro="A dropped ruler accelerates at a steady 9.81 m/s², so the distance it falls tells you exactly how long it was falling.">
    <div class="grid gap-4 md:grid-cols-2">
      <div class="card p-6">
        <p class="eyebrow">Metric</p>
        <p class="mt-3 font-mono text-lg text-ink">t = √(2d ÷ 9.81)</p>
        <p class="mt-2 text-sm leading-6 text-body">d in metres, t in seconds. Example: a 20 cm catch → √(2 × 0.20 ÷ 9.81) = 0.202 s = <strong class="font-medium text-ink">202 ms</strong>.</p>
      </div>
      <div class="card p-6">
        <p class="eyebrow">Imperial</p>
        <p class="mt-3 font-mono text-lg text-ink">t = √(2d ÷ 386)</p>
        <p class="mt-2 text-sm leading-6 text-body">d in inches, t in seconds. Example: a 6-inch catch → √(12 ÷ 386) = 0.176 s = <strong class="font-medium text-ink">176 ms</strong>.</p>
      </div>
    </div>
    <div class="prose-sr mt-8 max-w-3xl">
      <p>
        The formula comes from d = ½gt², the distance an object falls from rest in time t. It assumes your partner releases the ruler cleanly
        without pushing it, and that air resistance is negligible — both reasonable for a ruler falling less than 30 cm. Because the ruler
        keeps speeding up, each extra centimetre is worth fewer milliseconds the further it falls.
      </p>
    </div>
  </Section>

  <Section id="chart" eyebrow="Conversion" title="Ruler Drop Test Reaction Time Chart" intro="Look up your catch distance to read your reaction time, in centimetres or inches.">
    <div class="grid gap-6 lg:grid-cols-2">
      <DataTable caption="Ruler drop test chart in centimetres" head={['Distance', 'Reaction time', 'Seconds']} rows={cmRows} />
      <DataTable caption="Ruler drop test chart in inches" head={['Distance', 'Reaction time', 'Seconds']} rows={inRows} />
    </div>
  </Section>

  <Section id="norms" eyebrow="Benchmarks" title="Ruler Drop Test Norms: What Is a Good Score?" intro="The rating scale most often used in PE and sports-science classes was published for 16–19-year-olds.">
    <DataTable
      caption="Ruler drop test norms for 16–19-year-olds"
      head={['Rating', 'Catch (cm)', 'Catch (in)', 'Reaction time']}
      rows={normRows}
      note="Norms: Davis et al. (2000), Physical Education and the Study of Sport. Adults over 30 tend to score a little slower; compare yourself over time rather than against a single table."
    />
  </Section>

  <Section id="ruler-vs-online" eyebrow="Comparison" title="Ruler Drop Test vs an Online Reaction Time Test">
    <div class="grid gap-4 md:grid-cols-3">
      <div class="card p-6">
        <h3 class="text-heading-md">Why the ruler reads faster</h3>
        <p class="mt-2 text-sm leading-6 text-body">No screen refresh, no mouse or touchscreen lag, and a pinch is a tiny movement. Expect roughly 150–200 ms with a ruler where the same person scores 220–280 ms on a screen.</p>
      </div>
      <div class="card p-6">
        <h3 class="text-heading-md">Where it’s less precise</h3>
        <p class="mt-2 text-sm leading-6 text-body">You can only read the ruler to the nearest few millimetres, the dropper’s hand can give the game away, and slow reactions fall off the end of the ruler.</p>
      </div>
      <div class="card p-6">
        <h3 class="text-heading-md">Best of both</h3>
        <p class="mt-2 text-sm leading-6 text-body">
          Use the ruler drop for class experiments and quick checks, then take the
          <a href="/reaction-time-test/" class="text-link underline underline-offset-2">online reaction time test</a> for millisecond timing and saved progress.
        </p>
      </div>
    </div>
  </Section>

  <Section id="nelson-test" eyebrow="Variations" title="The Nelson Hand Reaction Test and Other Variations">
    <div class="prose-sr max-w-3xl">
      <p>
        The <strong>Nelson hand reaction test</strong> is a standardised version of the ruler drop. Instead of an ordinary ruler it uses a
        calibrated stick marked directly in fractions of a second, so no conversion is needed. The protocol is otherwise the same — forearm on
        a table, thumb and finger ready, partner releases the stick at random intervals — but it uses many more trials and discards the
        fastest and slowest before averaging, which makes the result far steadier than a single catch.
      </p>
      <p>
        There is also a foot version, where the stick is dropped beside a wall and trapped with the foot. Foot reactions are slower than hand
        reactions; our guide explains the <a href="/average-reaction-time/#foot-reaction-time">average foot reaction time</a> and why it matters
        for braking. For a sound-based comparison, try the <a href="/audio-reaction-time-test/">audio reaction time test</a>.
      </p>
    </div>
  </Section>

  <Faq items={faqs} title="Ruler Drop Test FAQ" />
  <RelatedTools current={tool.id} locale="en" />
</BaseLayout>
