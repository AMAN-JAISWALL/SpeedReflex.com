---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolHero from '../components/ToolHero.astro';
import Speedometer from '../components/Speedometer.astro';
import Section from '../components/Section.astro';
import StepList from '../components/StepList.astro';
import DataTable from '../components/DataTable.astro';
import Callout from '../components/Callout.astro';
import Faq from '../components/Faq.astro';
import RelatedTools from '../components/RelatedTools.astro';
import { toolById } from '../lib/site';
import { toolCrumbs, toolPage } from '../lib/schema';
import { getLocalizedPath, type Locale } from '../lib/i18n';
import { getTranslations } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const p = t.pages.flight;
const tool = toolById('flight');

const localizedHref = getLocalizedPath(tool.href, locale);
const crumbs = toolCrumbs(tool, locale, {
  home: t.nav.home,
  tool: t.tools.flight.name,
});
---

<BaseLayout
  title={p.title}
  description={p.description}
  jsonLd={toolPage(tool, p.title, p.description, p.faqs, locale, localizedHref, crumbs)}
  locale={locale}
>
  <ToolHero
    crumbs={crumbs}
    eyebrow={p.eyebrow}
    title={p.heroTitle}
    lede={p.lede}
    features={p.features}
  >
    <Speedometer preset="flight" locale={locale} />
    <div class="mt-4 max-w-3xl">
      <Callout title={p.tipsTitle}>
        {p.tips.join(' ')}
      </Callout>
    </div>
  </ToolHero>

  <Section id="how-to" eyebrow={p.howItWorksEyebrow} title={p.howItWorksTitle}>
    <StepList
      steps={p.steps.map((s) => ({
        title: s.t,
        text: s.d,
      }))}
    />
  </Section>

  <Section
    id="ground-speed-vs-airspeed"
    eyebrow={p.groundVsAirEyebrow}
    title={p.groundVsAirTitle}
    intro={p.groundVsAirIntro}
  >
    <div class="grid gap-4 md:grid-cols-2">
      {
        p.groundVsAirCards.map((c) => (
          <div class="card p-6">
            <h3 class="text-heading-md">{c.title}</h3>
            <p class="mt-2 text-sm leading-6 text-body">{c.text}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <Section
    id="typical-speeds"
    eyebrow={p.benchmarksEyebrow}
    title={p.benchmarksTitle}
    intro={p.benchmarksIntro}
  >
    <DataTable
      caption={p.benchmarksTitle}
      head={[p.tableAircraft, p.tableCruise, p.tableMax]}
      rows={p.flightRows.map((r) => [r.plane, r.cruise, r.max])}
    />
    <div class="prose-sr mt-8 max-w-3xl">
      <p>
        <a href={getLocalizedPath('/train-speed-test/', locale)}>
          {t.tools.train.name}
        </a>.
      </p>
    </div>
  </Section>

  <Faq items={p.faqs} title={p.faqTitle} />
  <RelatedTools current={tool.id} locale={locale} />
</BaseLayout>
