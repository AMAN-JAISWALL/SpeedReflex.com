---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE } from '../lib/site';
import { webPage, type Crumb } from '../lib/schema';
import { getLocalizedPath, type Locale } from '../lib/i18n';
import { getTranslations } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const p = t.pages.about;

const localizedHref = getLocalizedPath('/about/', locale);
const crumbs: Crumb[] = [
  { name: t.nav.home, href: getLocalizedPath('/', locale) },
  { name: t.nav.about, href: localizedHref },
];
---

<BaseLayout
  title={p.title}
  description={p.description}
  jsonLd={webPage({ href: localizedHref, name: p.title, description: p.description, crumbs, type: 'AboutPage', locale })}
  locale={locale}
>
  <section class="border-b border-hairline">
    <div class="shell max-w-3xl pb-16 pt-6 sm:pb-24 sm:pt-8">
      <Breadcrumbs crumbs={crumbs} />
      <p class="eyebrow mt-10">{p.eyebrow}</p>
      <h1 class="mt-3 text-display-sm sm:text-display">{p.heroTitle}</h1>
      <div class="prose-sr mt-8 text-lg leading-8">
        <p>{p.introP1}</p>
        <p>{p.introP2}</p>
      </div>
    </div>
  </section>

  <section class="border-b border-hairline" aria-labelledby="principles-title">
    <div class="shell py-16 sm:py-24">
      <h2 id="principles-title" class="text-heading-lg">{p.principlesTitle}</h2>
      <div class="mt-10 grid gap-px overflow-hidden rounded-md border border-hairline bg-hairline sm:grid-cols-2">
        {
          p.principles.map((pr) => (
            <div class="bg-surface p-6 sm:p-8">
              <h3 class="text-heading-md">{pr.t}</h3>
              <p class="mt-2 text-sm leading-6 text-body">{pr.d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-b border-hairline" aria-labelledby="method-title">
    <div class="shell grid gap-12 py-16 sm:py-24 lg:grid-cols-2">
      <div>
        <p class="eyebrow">{p.principlesTitle}</p>
        <h2 id="method-title" class="mt-3 text-heading-lg">{p.timingTitle}</h2>
        <ul class="prose-sr mt-6">
          {p.timingItems.map((item) => <li>{item}</li>)}
        </ul>
        <p class="mt-6 text-sm text-body">
          <a href={getLocalizedPath('/average-reaction-time/', locale)} class="font-medium text-link hover:text-link-deep">
            {t.guides.averageReactionTime.name} →
          </a>
        </p>
      </div>
      <div>
        <p class="eyebrow">{p.principlesTitle}</p>
        <h2 class="mt-3 text-heading-lg">{p.speedTitle}</h2>
        <ul class="prose-sr mt-6">
          {p.speedItems.map((item) => <li>{item}</li>)}
        </ul>
        <p class="mt-6 text-sm text-body">
          <a href={getLocalizedPath('/speedometer/', locale)} class="font-medium text-link hover:text-link-deep">
            {t.tools.speedometer.name} →
          </a>
        </p>
      </div>
    </div>
  </section>

  <section class="border-b border-hairline" aria-labelledby="contact-title">
    <div class="shell max-w-3xl py-16 sm:py-24">
      <h2 id="contact-title" class="text-heading-lg">{p.teamTitle}</h2>
      <div class="prose-sr mt-6">
        <p>{p.introP2}</p>
        <ul>
          <li>
            <a href={getLocalizedPath('/contact/', locale)} class="font-medium text-link hover:text-link-deep">
              {t.nav.contactUs}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/privacy/', locale)} class="font-medium text-link hover:text-link-deep">
              {t.nav.privacyPolicy}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/terms/', locale)} class="font-medium text-link hover:text-link-deep">
              {t.nav.termsConditions}
            </a>
          </li>
        </ul>
        <p class="mt-4">
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </p>
      </div>
    </div>
  </section>

  <CtaBand
    title={p.ctaTitle}
    text={p.ctaText}
    primary={{ href: getLocalizedPath('/reaction-time-test/', locale), label: p.ctaPrimary }}
    secondary={{ href: getLocalizedPath('/speedometer/', locale), label: p.ctaSecondary }}
  />
</BaseLayout>
