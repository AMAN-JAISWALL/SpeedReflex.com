---
import { House, ArrowLeft, RotateCcw, ServerCrash, MessageSquare } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/ToolCard.astro';
import { GUIDES, TOOLS } from '../lib/site';
import { getLocalizedPath, type Locale } from '../lib/i18n';
import { getTranslations } from '../i18n';

interface Props {
  locale: Locale;
  error?: unknown;
}

const { locale, error } = Astro.props;
const t = getTranslations(locale);
const p = t.pages.serverError;

const tools = TOOLS.map((tool) => ({
  id: tool.id,
  href: getLocalizedPath(tool.href, locale),
  name: t.tools[tool.id]?.name ?? tool.name,
  summary: t.tools[tool.id]?.summary ?? tool.summary,
}));

const guides = GUIDES.map((g) => ({
  id: 'guide' as const,
  href: getLocalizedPath(g.href, locale),
  name: t.guides.averageReactionTime.name,
  summary: t.guides.averageReactionTime.summary,
}));

const errorMessage = error instanceof Error ? error.message : typeof error === 'string' ? error : null;
const isDev = import.meta.env.DEV;
---

<BaseLayout
  title={p.title}
  description={p.description}
  noindex
  locale={locale}
>
  <div class="relative isolate overflow-hidden">
    <!-- Brand mesh gradient background in hero -->
    <div
      class="mesh pointer-events-none absolute -top-48 left-1/2 -z-10 h-[32rem] w-[56rem] -translate-x-1/2 opacity-35 dark:opacity-15"
      aria-hidden="true"
    ></div>

    <section class="shell py-16 sm:py-24">
      <div class="max-w-3xl">
        <!-- Eyebrow badge -->
        <div class="inline-flex items-center gap-2 rounded-full border border-hairline bg-surface px-3 py-1 text-xs font-mono font-medium text-error shadow-whisper">
          <span class="size-1.5 rounded-full bg-error" aria-hidden="true"></span>
          <span>{p.eyebrow}</span>
        </div>

        <h1 class="mt-4 text-display-sm sm:text-display text-ink tracking-tight font-semibold">
          {p.heading}
        </h1>
        <p class="mt-4 max-w-xl text-lg leading-7 text-body">
          {p.text}
        </p>

        <!-- Navigation actions: Retry + Home + Return to Previous Page + Contact -->
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <button
            type="button"
            class="btn btn-md btn-primary cursor-pointer"
            id="server-error-retry-btn"
          >
            <RotateCcw class="size-4" aria-hidden="true" />
            <span>{p.retryButton}</span>
          </button>
          <a href={getLocalizedPath('/', locale)} class="btn btn-md btn-secondary">
            <House class="size-4" aria-hidden="true" />
            <span>{p.homeButton}</span>
          </a>
          <a
            href={getLocalizedPath('/', locale)}
            class="btn btn-md btn-secondary cursor-pointer"
            id="server-error-back-btn"
          >
            <ArrowLeft class="size-4" aria-hidden="true" />
            <span>{p.backButton}</span>
          </a>
          <a href={getLocalizedPath('/contact/', locale)} class="btn btn-md btn-ghost">
            <MessageSquare class="size-4" aria-hidden="true" />
            <span>{p.contactButton}</span>
          </a>
        </div>
      </div>

      <!-- Developer diagnostics in DEV mode or System Status in Production -->
      {
        isDev && errorMessage ? (
          <div class="card mt-10 max-w-2xl p-5 sm:p-6 border border-red-500/30 bg-red-500/5 shadow-whisper">
            <div class="flex items-center gap-2 text-xs font-semibold text-error font-mono uppercase tracking-wider">
              <ServerCrash class="size-4" />
              <span>Development Error Diagnostic</span>
            </div>
            <pre class="mt-3 overflow-x-auto rounded bg-surface p-3 text-xs font-mono text-ink border border-hairline whitespace-pre-wrap">
              <code>{errorMessage}</code>
            </pre>
          </div>
        ) : (
          <div class="card mt-10 max-w-2xl p-5 sm:p-6 border border-hairline bg-surface shadow-whisper">
            <p class="text-xs font-mono font-medium uppercase tracking-wider text-mute">
              System Health & Diagnostics
            </p>
            <div class="mt-3 grid gap-3 sm:grid-cols-3 text-xs text-mute">
              <div>
                <span class="font-medium text-ink block mb-0.5">Data Protected</span>
                <span>All local history and test attempts in your browser remain intact.</span>
              </div>
              <div>
                <span class="font-medium text-ink block mb-0.5">Incident Logged</span>
                <span>Our telemetry tracks unhandled exceptions for fast remediation.</span>
              </div>
              <div>
                <span class="font-medium text-ink block mb-0.5">Standalone Tools</span>
                <span>Our reaction timers and calculators run client-side without servers.</span>
              </div>
            </div>
          </div>
        )
      }

      <!-- Popular Tools & Guides -->
      <div class="mt-14 border-t border-hairline pt-10">
        <h2 class="text-heading-md font-semibold text-ink">{p.popularHeading}</h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {tools.map((item) => <ToolCard tool={item} />)}
          {guides.map((item) => <ToolCard tool={item} />)}
        </div>
      </div>
    </section>
  </div>

  <script is:inline>
    (function() {
      var retryBtn = document.getElementById('server-error-retry-btn');
      if (retryBtn) {
        retryBtn.addEventListener('click', function() {
          window.location.reload();
        });
      }

      var backBtn = document.getElementById('server-error-back-btn');
      if (backBtn) {
        backBtn.addEventListener('click', function(e) {
          if (window.history.length > 1) {
            e.preventDefault();
            window.history.back();
          }
        });
      }
    })();
  </script>
</BaseLayout>
