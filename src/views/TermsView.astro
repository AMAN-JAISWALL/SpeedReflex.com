---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import { webPage, type Crumb } from '../lib/schema';
import { getLocalizedPath, type Locale } from '../lib/i18n';
import { getTranslations } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const p = t.pages.terms;

const localizedHref = getLocalizedPath('/terms/', locale);
const crumbs: Crumb[] = [
  { name: t.nav.home, href: getLocalizedPath('/', locale) },
  { name: t.nav.termsConditions, href: localizedHref },
];
---

<BaseLayout
  title={p.title}
  description={p.description}
  jsonLd={webPage({ href: localizedHref, name: p.title, description: p.description, crumbs, locale })}
  locale={locale}
>
  <article class="shell max-w-3xl py-16 sm:py-24">
    <Breadcrumbs crumbs={crumbs} />
    <p class="eyebrow mt-10">{t.nav.termsConditions}</p>
    <h1 class="mt-3 text-display-sm sm:text-display">{p.heroTitle}</h1>
    <p class="mt-4 text-sm text-mute">{p.lastUpdated}</p>

    <div class="prose-sr mt-10">
      <p>{p.lede}</p>

      {
        p.sections.map((sec) => (
          <>
            <h2 class="mt-10! text-heading-md text-ink">{sec.title}</h2>
            <div set:html={sec.content} />
          </>
        ))
      }
    </div>
  </article>

  <CtaBand
    title={t.pages.home.ctaTitle}
    text={t.pages.home.ctaText}
    primary={{ href: getLocalizedPath('/reaction-time-test/', locale), label: t.pages.home.ctaPrimary }}
    secondary={{ href: getLocalizedPath('/speedometer/', locale), label: t.pages.home.ctaSecondary }}
  />
</BaseLayout>
