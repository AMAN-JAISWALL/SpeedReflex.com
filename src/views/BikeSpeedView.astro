---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolHero from '../components/ToolHero.astro';
import Speedometer from '../components/Speedometer.astro';
import Section from '../components/Section.astro';
import StepList from '../components/StepList.astro';
import DataTable from '../components/DataTable.astro';
import Faq from '../components/Faq.astro';
import RelatedTools from '../components/RelatedTools.astro';
import { toolById } from '../lib/site';
import { toolCrumbs, toolPage } from '../lib/schema';
import { getLocalizedPath, type Locale } from '../lib/i18n';
import { getTranslations } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const p = t.pages.bike;
const tool = toolById('bike');

const localizedHref = getLocalizedPath(tool.href, locale);
const crumbs = toolCrumbs(tool, locale, {
  home: t.nav.home,
  tool: t.tools.bike.name,
});
---

<BaseLayout
  title={p.title}
  description={p.description}
  jsonLd={toolPage(tool, p.title, p.description, p.faqs, locale, localizedHref, crumbs)}
  locale={locale}
>
  <ToolHero
    crumbs={crumbs}
    eyebrow={p.eyebrow}
    title={p.heroTitle}
    lede={p.lede}
    features={p.features}
  >
    <Speedometer preset="bike" locale={locale} />
  </ToolHero>

  <Section id="how-to" eyebrow={p.howItWorksEyebrow} title={p.howItWorksTitle}>
    <StepList
      steps={p.steps.map((s) => ({
        title: s.t,
        text: s.d,
      }))}
    />
  </Section>

  <Section
    id="cycling-speeds"
    eyebrow={p.limitsEyebrow}
    title={p.limitsTitle}
    intro={p.limitsIntro}
  >
    <DataTable
      caption={p.limitsTitle}
      head={[p.tableVehicle, p.tableCutoff, p.tablePower]}
      rows={p.limitsRows.map((r) => [r.type, r.cutoff, r.power])}
      note={p.limitsProse}
    />
  </Section>

  <Section id="mounting" eyebrow={p.mountingEyebrow} title={p.mountingTitle}>
    <div class="grid gap-4 md:grid-cols-3">
      {
        p.mountingPoints.map((pt) => (
          <div class="card p-6">
            <h3 class="text-heading-md">{pt.title}</h3>
            <p class="mt-2 text-sm leading-6 text-body">{pt.text}</p>
          </div>
        ))
      }
    </div>
    <div class="prose-sr mt-8 max-w-3xl">
      <p>
        <a href={getLocalizedPath('/car-speed-test/', locale)} class="mr-3">
          {t.tools.car.name}
        </a>
        <a href={getLocalizedPath('/speedometer/', locale)}>
          {t.tools.speedometer.name}
        </a>
      </p>
    </div>
  </Section>

  <Faq items={p.faqs} title={p.faqTitle} />
  <RelatedTools current={tool.id} locale={locale} />
</BaseLayout>
