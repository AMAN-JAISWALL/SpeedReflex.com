---
import { ArrowRight } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Section from '../components/Section.astro';
import DataTable from '../components/DataTable.astro';
import Faq from '../components/Faq.astro';
import ToolCard from '../components/ToolCard.astro';
import { toolById } from '../lib/site';
import { articlePage, type Crumb } from '../lib/schema';
import { ANTICIPATION_MS } from '../lib/reaction';
import { getLocalizedPath, type Locale } from '../lib/i18n';
import { getTranslations } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const p = t.pages.averageReaction;

const localizedHref = getLocalizedPath('/average-reaction-time/', locale);
const published = '2026-09-28';
const modified = '2026-09-29';
const crumbs: Crumb[] = [
  { name: t.nav.home, href: getLocalizedPath('/', locale) },
  { name: t.guides.averageReactionTime.name, href: localizedHref },
];

const promoTools = [toolById('reaction'), toolById('f1'), toolById('stopping')].map((tool) => ({
  id: tool.id,
  href: getLocalizedPath(tool.href, locale),
  name: t.tools[tool.id]?.name ?? tool.name,
  summary: t.tools[tool.id]?.summary ?? tool.summary,
}));

const sources = [
  { t: 'Kosinski, R. J. (2013) — A Literature Review on Reaction Time, Clemson University', href: 'https://web.archive.org/web/20260302094445/http://www.cognaction.org/cogs105/readings/clemson.rt.pdf' },
  { t: 'Der, G. & Deary, I. J. (2006) — Age and sex differences in reaction time in adulthood, Psychology and Aging 21(1)', href: 'https://pubmed.ncbi.nlm.nih.gov/16594792/' },
  { t: 'Green, M. (2000) — “How long does it take to stop?” Driver perception-brake times, Transportation Human Factors 2(3)', href: 'https://www.tandfonline.com/doi/abs/10.1207/STHF0203_1' },
  { t: 'Williamson, A. M. & Feyer, A.-M. (2000) — Moderate sleep deprivation and alcohol, Occupational and Environmental Medicine 57(10)', href: 'https://pubmed.ncbi.nlm.nih.gov/10984335/' },
  { t: 'World Athletics — Technical Rules, TR 16.6 (false starts)', href: 'https://worldathletics.org/about-iaaf/documents/book-of-rules' },
  { t: 'World Athletics — Bolt’s 9.58 world record in Berlin, 2009', href: 'https://worldathletics.org/news/news/bolt-again-958-world-record-in-berlin-updat' },
  { t: 'Human Benchmark — Reaction time statistics', href: 'https://humanbenchmark.com/tests/reactiontime/statistics' },
];
---

<BaseLayout
  title={p.title}
  description={p.description}
  ogType="article"
  jsonLd={articlePage({ href: localizedHref, headline: p.title, description: p.description, datePublished: published, dateModified: modified, crumbs, faq: p.faqs, locale })}
  locale={locale}
>
  <article>
    <header class="relative isolate overflow-hidden border-b border-hairline">
      <div class="mesh pointer-events-none absolute -top-48 left-1/2 -z-10 h-[30rem] w-[56rem] -translate-x-1/2 opacity-40 dark:opacity-25" aria-hidden="true"></div>
      <div class="shell pb-12 pt-6 sm:pb-16 sm:pt-8">
        <Breadcrumbs crumbs={crumbs} />
        <div class="mt-6 max-w-3xl">
          <p class="eyebrow">{p.eyebrow}</p>
          <h1 class="mt-3 text-display-sm sm:text-display">{p.heroTitle}</h1>
          <p class="mt-4 text-lg leading-7 text-body">{p.lede}</p>
          <p class="mt-4 text-sm text-mute">
            SpeedReflex · Updated <time datetime={modified}>2026</time>
          </p>
        </div>

        <a
          href={getLocalizedPath('/reaction-time-test/', locale)}
          class="group mt-8 flex items-center justify-between gap-4 rounded-md border border-hairline bg-surface p-5 transition-colors hover:border-hairline-strong"
        >
          <span>
            <span class="block text-label text-ink">{t.tools.reaction.name}</span>
            <span class="mt-1 block text-sm text-body">{t.tools.reaction.summary}</span>
          </span>
          <span class="btn btn-md btn-primary shrink-0">
            {t.nav.startTest} <ArrowRight size={16} class="transition-transform group-hover:translate-x-0.5 motion-reduce:transition-none" />
          </span>
        </a>
      </div>
    </header>

    <Section id="device-lag" eyebrow={p.deviceLagEyebrow} title={p.deviceLagTitle} intro={p.deviceLagIntro}>
      <div class="grid gap-4 sm:grid-cols-2">
        {
          p.deviceLagCards.map((c) => (
            <div class="card p-6">
              <h3 class="text-heading-md">{c.title}</h3>
              <p class="mt-2 text-sm leading-6 text-body">{c.text}</p>
            </div>
          ))
        }
      </div>
    </Section>

    <Section
      id="good-reaction-time"
      eyebrow={p.benchmarksEyebrow}
      title={p.benchmarksTitle}
      intro={p.benchmarksIntro}
    >
      <DataTable
        caption={p.benchmarksTitle}
        head={[p.benchmarksTableAvg, p.benchmarksTableRating, p.benchmarksTablePercentile]}
        rows={p.benchmarkRows.map((r) => [r.time, r.rating, r.pct])}
        note={p.proseModel}
      />
    </Section>

    <Section
      id="by-age"
      eyebrow={p.ageEyebrow}
      title={p.ageTitle}
      intro={p.ageIntro}
    >
      <DataTable
        caption={p.ageTitle}
        head={[p.ageTableGroup, p.ageTableSimple, p.ageTableChoice]}
        rows={p.ageRows.map((r) => [r.age, r.simple, r.choice])}
      />
    </Section>

    <Section id="stimulus" eyebrow={p.stimulusEyebrow} title={p.stimulusTitle} intro={p.stimulusIntro}>
      <DataTable
        caption={p.stimulusTitle}
        head={[p.stimulusTableStim, p.stimulusTableAvg, p.stimulusTableRange]}
        rows={p.stimulusRows.map((r) => [r.stimulus, r.avg, r.range])}
      />
      <div class="prose-sr mt-8 max-w-3xl">
        <p>
          <a href={getLocalizedPath('/audio-reaction-time-test/', locale)} class="mr-3">
            {t.tools.audio.name}
          </a>
          <a href={getLocalizedPath('/reaction-time-test/', locale)}>
            {t.tools.reaction.name}
          </a>
        </p>
      </div>
    </Section>

    <Faq items={p.faqs} title={p.faqTitle} />

    <Section id="sources" eyebrow="References" title="Sources">
      <ol class="prose-sr max-w-3xl list-decimal pl-5 text-sm marker:text-faint">
        {
          sources.map((s) => (
            <li>
              <a href={s.href} rel="noopener" target="_blank">
                {s.t}
              </a>
            </li>
          ))
        }
      </ol>
    </Section>
  </article>

  <Section id="try-it" eyebrow={t.nav.relatedToolsTitle} title={t.nav.relatedToolsIntro}>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {promoTools.map((pt) => <ToolCard tool={pt} />)}
    </div>
  </Section>
</BaseLayout>
